# ============================================================================
# Caddy — reverse proxy TLS delante de ERP Tahona
# Montado en el contenedor "proxy" de docker-compose.yml en /etc/caddy/Caddyfile
#
# Variables (definidas en .env, ver .env.example):
#   ERP_DOMAIN    dominio del sitio. Por defecto "localhost".
#   ERP_TLS_MODE  primer argumento de la directiva `tls`:
#                 - "internal" (por defecto): certificado autofirmado emitido por
#                   la CA interna de Caddy. Es la opción para LAN sin dominio
#                   público. Los navegadores avisarán salvo que se instale la CA
#                   raíz de Caddy (/data/caddy/pki/authorities/local/root.crt)
#                   en los equipos cliente. Ver docs/RUNBOOK.md.
#                 - un email (p.ej. "admin@mibakery.es"): activa ACME/Let's
#                   Encrypt para ERP_DOMAIN. Requiere dominio público que
#                   resuelva a este host y puertos 80/443 alcanzables.
# ============================================================================

{$ERP_DOMAIN:localhost} {
	tls {$ERP_TLS_MODE:internal}

	# Compresión de respuestas de texto (HTML/CSS/JS/JSON)
	encode zstd gzip

	# NOTA sobre la IP real y el rate limiter de login:
	# reverse_proxy añade X-Forwarded-For/X-Forwarded-Proto automáticamente.
	# La app corre con server.forward-headers-strategy=native
	# (application-prod.properties), que activa el RemoteIpValve de Tomcat:
	# este solo confía en X-Forwarded-* cuando el peer es un proxy interno
	# (por defecto los rangos privados RFC1918, donde cae la red del compose),
	# de modo que request.getRemoteAddr() devuelve la IP real del cliente y el
	# LoginRateLimitFilter limita por cliente, no por la IP de Caddy.
	# Verificado en el test LoginRateLimitForwardedIpTest.
	reverse_proxy app:8080
}
