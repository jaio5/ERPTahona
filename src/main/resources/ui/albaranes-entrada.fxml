<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  MODERN & RESPONSIVE LAYOUT
  - Root: AnchorPane to allow flexible positioning and scaling.
  - Header: VBox at the top for title and actions, using HBox for alignment.
  - Content: SplitPane for a responsive master-detail view.
  - Table Section (Left): VBox for filters and the main table. TextFields and other controls are set to grow.
  - Form Section (Right): GridPane for a clean, aligned, and responsive form layout.
  - Styling: All inline styles removed. All styling is now driven by 'styles.css' using class selectors.
-->
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.AlbaranesEntradaController"
            styleClass="page-view"
            stylesheets="@/css/styles.css">
    <VBox AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <!-- Header -->
        <VBox styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📥" styleClass="header-icon"/>
                    <Label text="Gestión de Albaranes de Entrada" styleClass="header-title"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
            </HBox>
        </VBox>

        <!-- Main Content -->
        <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS" styleClass="page-content">
            <!-- Left Panel: Table and Filters -->
            <VBox spacing="15" styleClass="card">
                <VBox spacing="15" styleClass="filters-panel">
                    <Label text="🔎 Búsqueda y Filtros" styleClass="subsection-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Buscar:" styleClass="form-label"/>
                        <TextField fx:id="txtSearch" promptText="Número, proveedor..." HBox.hgrow="ALWAYS" styleClass="search-field"/>
                        <Button text="🔎 Buscar" onAction="#handleSearch" styleClass="btn-primary"/>
                        <Button text="⟳ Limpiar" onAction="#handleSearch" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>
                <TableView fx:id="tableAlbaranesEntrada" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNumero" text="Número"/>
                        <TableColumn fx:id="colFecha" text="Fecha"/>
                        <TableColumn fx:id="colProveedor" text="Proveedor"/>
                        <TableColumn fx:id="colEstado" text="Estado"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right Panel: Form -->
            <AnchorPane>
                <VBox spacing="20" styleClass="card" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
                    <Label text="📝 Datos del Albarán" styleClass="section-title"/>
                    
                    <!-- Responsive Form using GridPane -->
                    <GridPane hgap="10" vgap="15" VBox.vgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="120.0"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        
                        <Label text="Número:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtNumero" promptText="Número de albarán" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        
                        <Label text="Fecha:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <DatePicker fx:id="dpFecha" promptText="Fecha" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        
                        <Label text="Proveedor:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cboProveedor" promptText="Selecciona proveedor" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        
                        <Label text="Estado:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cboEstado" promptText="Selecciona estado" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <rowConstraints>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        </rowConstraints>
                    </GridPane>
                    
                    <!-- Action Buttons -->
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="main-actions">
                        <Button text="➕ Nuevo" onAction="#handleNuevo" styleClass="btn-primary"/>
                        <Button text="💾 Guardar" onAction="#handleGuardar" styleClass="btn-success"/>
                        <Button text="🗑 Eliminar" onAction="#handleEliminar" styleClass="btn-danger"/>
                    </HBox>
                </VBox>
            </AnchorPane>
        </SplitPane>
    </VBox>
</AnchorPane>
