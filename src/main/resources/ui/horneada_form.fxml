<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.formcontroller.HorneadaFormController"
      spacing="12" style="-fx-padding: 24; -fx-background-color: #f8f9fa;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <Label text="REGISTRO DE HORNEADA" styleClass="title"/>

    <GridPane hgap="12" vgap="8">
        <padding><Insets top="10" right="0" bottom="10" left="0"/></padding>
        <Label text="Fecha:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpFecha" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Tipo:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbTipo" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Temp. inicial (°C):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTempInicial" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Temp. final (°C):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTempFinal" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Humedad inicial (%):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtHumedad" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Cantidad producida:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCantidad" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Merma:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="txtMerma" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Resultado:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbResultado" maxWidth="Infinity" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Observaciones:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <TextArea fx:id="txtObservaciones" prefRowCount="2" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#onCancelar" styleClass="button"/>
        <Button text="Guardar" onAction="#onGuardar" styleClass="button-success"/>
    </HBox>
</VBox>
