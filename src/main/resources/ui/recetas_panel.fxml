<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.RecetaController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="RECETAS" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refrescar" onAction="#onRefresh" styleClass="button"/>
        <Button text="+ Nueva Receta" onAction="#onNuevo" styleClass="button-success"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="Buscar receta..." HBox.hgrow="ALWAYS" style="-fx-min-height: 40px;"/>
        <Button text="Buscar" onAction="#onBuscar" styleClass="button-primary"/>
    </HBox>

    <TableView fx:id="tableRecetas" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" minWidth="70" maxWidth="100"/>
            <TableColumn fx:id="colNombre" text="Nombre" minWidth="200"/>
            <TableColumn fx:id="colTiempoPrep" text="Prep (min)" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="colTemperatura" text="Temp (°C)" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="colActivo" text="Activo" minWidth="60" maxWidth="80"/>
        </columns>
    </TableView>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Editar" onAction="#onEditar" styleClass="button-primary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 recetas" style="-fx-text-fill: #6c757d;"/>
    </HBox>
</VBox>
