<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="alicanteweb.erp.controller.Modelo347FormController" fitToWidth="true" fitToHeight="true">
    <content>
        <BorderPane xmlns="http://javafx.com/javafx/21"
                    stylesheets="@/styles/modern-theme.css"
                    style="-fx-background-color: #f8fafc;">

            <top>
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15 20; -fx-border-width: 0 0 1 0; -fx-border-color: #e2e8f0;">
                    <Label text="📊" style="-fx-font-size: 24;"/>
                    <VBox spacing="2">
                        <Label text="Modelo 347 - Declaración Anual de Operaciones" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                        <Label text="Operaciones con terceras personas superiores a 3.005,06 €" style="-fx-text-fill: #64748b; -fx-font-size: 12;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblEstado" text="PENDIENTE" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #f59e0b; -fx-padding: 6 12; -fx-background-color: #fef3c7; -fx-background-radius: 6;"/>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                    <VBox spacing="15" style="-fx-padding: 20;">

                        <!-- PARÁMETROS DE GENERACIÓN -->
                        <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 12; -fx-background-radius: 12;">
                            <Label text="Parámetros de Generación" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                            <Separator/>

                            <GridPane hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="33.33"/>
                                    <ColumnConstraints percentWidth="33.33"/>
                                    <ColumnConstraints percentWidth="33.33"/>
                                </columnConstraints>

                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Ejercicio Fiscal *" style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                                    <TextField fx:id="txtEjercicio" promptText="2025" style="-fx-padding: 10;"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Tipo de Declaración" style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                                    <ComboBox fx:id="cbTipo" promptText="Complementaria/Sustitutiva" maxWidth="Infinity"/>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="Número Identificación" style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                                    <TextField fx:id="txtNumeroIdentificacion" promptText="Si es complementaria" style="-fx-padding: 10;"/>
                                </VBox>
                            </GridPane>

                            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 15 0 0 0;">
                                <Label text="💡" style="-fx-font-size: 16;"/>
                                <Label text="Se incluirán automáticamente todas las operaciones superiores a 3.005,06 € del ejercicio seleccionado"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 12;" wrapText="true" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>

                        <!-- RESUMEN DE OPERACIONES -->
                        <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 12; -fx-background-radius: 12;">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Operaciones a Declarar" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="🔄 Calcular" onAction="#onCalcular" styleClass="button-primary" style="-fx-padding: 8 16;"/>
                            </HBox>
                            <Separator/>

                            <GridPane hgap="20" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="33.33"/>
                                    <ColumnConstraints percentWidth="33.33"/>
                                    <ColumnConstraints percentWidth="33.33"/>
                                </columnConstraints>

                                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-padding: 12; -fx-background-color: #f0fdf4; -fx-background-radius: 8;">
                                    <Label text="Total Ventas/Ingresos" style="-fx-font-size: 11; -fx-text-fill: #166534;"/>
                                    <Label fx:id="txtTotalIngresos" text="0.00 €" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-padding: 12; -fx-background-color: #fef3c7; -fx-background-radius: 8;">
                                    <Label text="Total Compras/Gastos" style="-fx-font-size: 11; -fx-text-fill: #92400e;"/>
                                    <Label fx:id="txtTotalGastos" text="0.00 €" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                                </VBox>

                                <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-padding: 12; -fx-background-color: #ede9fe; -fx-background-radius: 8;">
                                    <Label text="Número de Operaciones" style="-fx-font-size: 11; -fx-text-fill: #5b21b6;"/>
                                    <Label fx:id="lblNumeroOperaciones" text="0" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
                                </VBox>
                            </GridPane>

                            <TableView fx:id="tableOperaciones" VBox.vgrow="ALWAYS" prefHeight="300">
                                <columns>
                                    <TableColumn fx:id="colNIF" text="NIF" prefWidth="120"/>
                                    <TableColumn fx:id="colTercero" text="Tercero (Cliente/Proveedor)" prefWidth="250"/>
                                    <TableColumn fx:id="colTipo" text="Tipo Operación" prefWidth="150"/>
                                    <TableColumn fx:id="colImporte" text="Importe Total" prefWidth="120"/>
                                    <TableColumn fx:id="colTrimestres" text="Trimestrales" prefWidth="200"/>
                                </columns>
                            </TableView>
                        </VBox>

                        <!-- INFORMACIÓN ADICIONAL -->
                        <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 12; -fx-background-radius: 12;">
                            <Label text="Información Adicional" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                            <Separator/>
                            <TextArea fx:id="txtObservaciones" promptText="Observaciones o notas sobre esta declaración..." prefRowCount="3"/>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </center>

            <bottom>
                <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-background-color: white; -fx-padding: 15 20; -fx-border-width: 1 0 0 0; -fx-border-color: #e2e8f0;">
                    <Button text="📥 Importar XML" onAction="#onImportarXML" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-padding: 10 24; -fx-font-size: 13;"/>
                    <Button text="Cancelar" onAction="#onCancelar" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-padding: 10 24; -fx-font-size: 13;"/>
                    <Button text="📊 Generar Declaración" onAction="#onGenerar" styleClass="button-success" style="-fx-padding: 10 24; -fx-font-size: 13; -fx-font-weight: bold;"/>
                </HBox>
            </bottom>

        </BorderPane>
    </content>
</ScrollPane>
