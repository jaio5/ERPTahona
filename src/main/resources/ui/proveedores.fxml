<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="alicanteweb.erp.controller.ProveedoreController">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Proveedores" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Volver" onAction="#handleVolver"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10" style="-fx-padding:10">
            <TableView fx:id="tableProveedores" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código"/>
                    <TableColumn fx:id="colNombre" text="Nombre"/>
                    <TableColumn fx:id="colCif" text="CIF"/>
                    <TableColumn fx:id="colPoblacion" text="Población"/>
                </columns>
            </TableView>
            <Separator/>
            <GridPane hgap="10" vgap="10">
                <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="CIF:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtCif" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Población:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtPoblacion" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>
            <HBox spacing="10" alignment="CENTER">
                <Button text="Nuevo" onAction="#handleNuevo"/>
                <Button text="Guardar" onAction="#handleGuardar"/>
                <Button text="Eliminar" onAction="#handleEliminar"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
