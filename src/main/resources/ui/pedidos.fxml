<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.PedidoController">
    <top>
        <VBox styleClass="header">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Gestión de Pedidos" styleClass="header-title">
                    <font><Font name="System Bold" size="22"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="10" style="-fx-padding:10">
            <HBox spacing="10">
                <TextField fx:id="txtSearch" promptText="Número, cliente..." />
                <Button text="Buscar" onAction="#handleSearch"/>
            </HBox>
            <TableView fx:id="tablePedidos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNumero" text="Número" />
                    <TableColumn fx:id="colFecha" text="Fecha" />
                    <TableColumn fx:id="colCliente" text="Cliente" />
                    <TableColumn fx:id="colEstado" text="Estado" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
