<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="alicanteweb.erp.controller.UsuarioController">
    <center>
        <VBox spacing="8">
            <HBox spacing="8">
                <TextField fx:id="txtBuscar" promptText="Buscar..." />
                <ComboBox fx:id="cmbFiltroRol" />
                <ComboBox fx:id="cmbFiltroEstado" />
                <Button text="Buscar" onAction="#onBuscar" />
            </HBox>

            <TableView fx:id="tableUsuarios">
                <columns>
                    <TableColumn fx:id="colId" text="ID" />
                    <TableColumn fx:id="colUsername" text="Usuario" />
                    <TableColumn fx:id="colNombre" text="Nombre" />
                    <TableColumn fx:id="colEmail" text="Email" />
                    <TableColumn fx:id="colRol" text="Rol" />
                    <TableColumn fx:id="colActivo" text="Estado" />
                    <TableColumn fx:id="colUltimoAcceso" text="Último Acceso" />
                    <TableColumn fx:id="colAcciones" text="Acciones" />
                </columns>
            </TableView>

            <HBox spacing="8">
                <Label fx:id="lblTotal" text="0 usuarios" />
                <Label fx:id="lblSeleccion" text="Ningún usuario seleccionado" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="8">
            <Button text="Nuevo" onAction="#onNuevo" />
            <Button text="Editar" onAction="#onEditar" />
            <Button text="Eliminar" onAction="#onEliminar" />
            <Button text="Cambiar contraseña" onAction="#onCambiarPassword" />
            <Button text="Bloquear" onAction="#onBloquear" />
            <Button text="Desbloquear" onAction="#onDesbloquear" />
            <Button text="Desactivar" onAction="#onDesactivar" />
            <Button text="Refresh" onAction="#onRefresh" />
        </HBox>
    </bottom>
</BorderPane>
