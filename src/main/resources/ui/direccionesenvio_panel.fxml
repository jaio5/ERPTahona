<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.DireccionenvioController"
      spacing="12" style="-fx-padding: 20; -fx-background-color: #f8f9fa;">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="📫 Direcciones de Envío" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄" onAction="#onRefresh" styleClass="button"/>
        <Button text="+ Nueva Dirección" onAction="#onNuevo" styleClass="button-success"/>
    </HBox>

    <HBox spacing="8">
        <TextField fx:id="txtBuscar" promptText="Buscar por población..." HBox.hgrow="ALWAYS"/>
        <Button text="Buscar" onAction="#onBuscar" styleClass="button-primary"/>
    </HBox>

    <TableView fx:id="tableDirecciones" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="colCodigoDireccion" text="Cód." prefWidth="60"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
            <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="220"/>
            <TableColumn fx:id="colPoblacion" text="Población" prefWidth="120"/>
            <TableColumn fx:id="colProvincia" text="Provincia" prefWidth="120"/>
            <TableColumn fx:id="colCP" text="CP"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120"/>
            <TableColumn fx:id="colNotas" text="Notas" prefWidth="200"/>
            <TableColumn fx:id="colAcciones" prefWidth="120"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="lblTotal" text="0 direcciones" style="-fx-text-fill: #6c757d;"/>
    </HBox>

</VBox>

