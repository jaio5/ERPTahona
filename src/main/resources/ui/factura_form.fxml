<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.FacturaFormController"
            stylesheets="@/styles/modern-theme.css"
            style="-fx-background-color: #f8fafc;">

    <!-- HEADER -->
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15 20; -fx-border-width: 0 0 1 0; -fx-border-color: #e2e8f0;">
            <Label text="🧾" style="-fx-font-size: 24;"/>
            <VBox spacing="2">
                <Label fx:id="lblTitulo" text="Nueva Factura de Venta" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Label fx:id="lblNumeroFactura" text="Número: Pendiente" style="-fx-text-fill: #64748b; -fx-font-size: 12;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="lblEstado" text="BORRADOR" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                <Label fx:id="lblTotal" text="Total: 0.00 €" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            </VBox>
        </HBox>
    </top>

    <!-- CONTENIDO -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="15" style="-fx-padding: 20;">

                <!-- DATOS PRINCIPALES -->
                <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                    <Label text="Datos de la Factura" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <Separator/>

                    <GridPane hgap="15" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                        </columnConstraints>

                        <!-- CLIENTE -->
                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Cliente *" style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                            <HBox spacing="8">
                                <ComboBox fx:id="cbCliente" promptText="Seleccionar cliente..." HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button text="➕" onAction="#onNuevoCliente"
                                        style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 8 12; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>

                        <!-- FECHA -->
                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Fecha *" style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                            <DatePicker fx:id="dpFecha" maxWidth="Infinity" style="-fx-padding: 10;"/>
                        </VBox>

                        <!-- FORMA DE PAGO -->
                        <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label text="Forma de Pago" style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                            <ComboBox fx:id="cbFormaPago" promptText="Contado" maxWidth="Infinity"/>
                        </VBox>

                        <!-- SERIE -->
                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Serie" style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                            <ComboBox fx:id="cbSerie" promptText="A" maxWidth="Infinity"/>
                        </VBox>

                        <!-- VENCIMIENTO -->
                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Vencimiento" style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                            <DatePicker fx:id="dpVencimiento" maxWidth="Infinity" style="-fx-padding: 10;"/>
                        </VBox>

                        <!-- DESCUENTO GENERAL -->
                        <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <Label text="Descuento (%)" style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                            <TextField fx:id="txtDescuentoGeneral" text="0" promptText="0" style="-fx-padding: 10;"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- LÍNEAS DE FACTURA -->
                <VBox VBox.vgrow="ALWAYS" spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Líneas de Factura" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="➕ Añadir Línea" styleClass="button-success" onAction="#onAgregarLinea"
                                style="-fx-font-size: 12; -fx-padding: 8 16;"/>
                    </HBox>
                    <Separator/>

                    <TableView fx:id="tableLineas" prefHeight="280" style="-fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                        <columns>
                            <TableColumn fx:id="colArticulo" text="Artículo" prefWidth="250"/>
                            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="200"/>
                            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="90" style="-fx-alignment: CENTER-RIGHT;"/>
                            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100" style="-fx-alignment: CENTER-RIGHT;"/>
                            <TableColumn fx:id="colDescuento" text="Dto. %" prefWidth="70" style="-fx-alignment: CENTER-RIGHT;"/>
                            <TableColumn fx:id="colIva" text="IVA %" prefWidth="70" style="-fx-alignment: CENTER-RIGHT;"/>
                            <TableColumn fx:id="colImporte" text="Importe" prefWidth="110" style="-fx-alignment: CENTER-RIGHT;"/>
                            <TableColumn fx:id="colAcciones" text="" prefWidth="70"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- TOTALES -->
                <HBox spacing="15">
                    <!-- OBSERVACIONES -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                        <Label text="Observaciones" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                        <TextArea fx:id="txtObservaciones" promptText="Notas adicionales para la factura..."
                                  prefRowCount="4" wrapText="true" style="-fx-padding: 10;"/>
                    </VBox>

                    <!-- RESUMEN TOTALES -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2); -fx-min-width: 300;">
                        <Label text="Resumen" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                        <Separator/>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Base Imponible:" style="-fx-font-size: 13; -fx-text-fill: #64748b;" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblBaseImponible" text="0.00 €" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #1e293b;"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Descuentos:" style="-fx-font-size: 13; -fx-text-fill: #64748b;" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblDescuentos" text="0.00 €" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #dc2626;"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="IVA (21%):" style="-fx-font-size: 13; -fx-text-fill: #64748b;" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblIva" text="0.00 €" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #1e293b;"/>
                        </HBox>

                        <Separator/>

                        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-radius: 6; -fx-background-radius: 6;">
                            <Label text="TOTAL:" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblTotalResumen" text="0.00 €" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                        </HBox>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- FOOTER CON BOTONES -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-background-color: white; -fx-padding: 15 20; -fx-border-width: 1 0 0 0; -fx-border-color: #e2e8f0;">
            <Button text="Cancelar" onAction="#onCancelar"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-padding: 10 24; -fx-font-size: 13; -fx-cursor: hand;"/>
            <Button text="💾 Guardar Borrador" onAction="#onGuardarBorrador" styleClass="button-warning"
                    style="-fx-padding: 10 24; -fx-font-size: 13;"/>
            <Button text="📝 Guardar y Emitir" onAction="#onGuardarEmitir" styleClass="button-primary"
                    style="-fx-padding: 10 24; -fx-font-size: 13;"/>
            <Button text="✓ Guardar y Enviar AEAT" onAction="#onGuardarEnviarAEAT" styleClass="button-success"
                    style="-fx-padding: 10 24; -fx-font-size: 13; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>

</BorderPane>

