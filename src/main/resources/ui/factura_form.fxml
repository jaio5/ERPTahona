<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.formcontroller.FacturaFormController"
            stylesheets="@/styles/simple-theme.css"
            fitToWidth="true" fitToHeight="true">
    <content>
        <BorderPane styleClass="form-root">
            <top>
                <HBox styleClass="form-header">
                    <VBox spacing="2">
                        <Label fx:id="lblTitulo" text="Nueva factura" styleClass="title"/>
                        <Label fx:id="lblNumeroFactura" text="Numero: pendiente" styleClass="subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label fx:id="lblEstado" text="BORRADOR" styleClass="badge badge-info"/>
                        <Label fx:id="lblTotal" text="Total: 0.00 EUR" styleClass="total-label"/>
                    </VBox>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true">
                    <VBox styleClass="form-body">
                        <VBox styleClass="form-section">
                            <Label text="Datos de factura" styleClass="section-title"/>
                            <GridPane styleClass="form-grid">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                </columnConstraints>

                                <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Cliente *" styleClass="form-label"/>
                                    <ComboBox fx:id="cbCliente" promptText="Seleccionar cliente..." maxWidth="Infinity"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Fecha emision *" styleClass="form-label"/>
                                    <DatePicker fx:id="dpFechaEmision" maxWidth="Infinity"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="Vencimiento" styleClass="form-label"/>
                                    <DatePicker fx:id="dpFechaVencimiento" maxWidth="Infinity"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="Forma de pago" styleClass="form-label"/>
                                    <ComboBox fx:id="cbFormaPago" promptText="Seleccionar" maxWidth="Infinity"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                    <Label text="Observaciones" styleClass="form-label"/>
                                    <TextField fx:id="txtObservaciones" promptText="Notas adicionales..."/>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <VBox styleClass="form-section">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Lineas" styleClass="section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Agregar articulo" onAction="#onAgregarLinea" styleClass="button-success"/>
                            </HBox>

                            <TableView fx:id="tableLineas" VBox.vgrow="ALWAYS" prefHeight="220">
                                <columns>
                                    <TableColumn fx:id="colArticulo" text="Articulo" minWidth="120"/>
                                    <TableColumn fx:id="colDescripcion" text="Descripcion" minWidth="150"/>
                                    <TableColumn fx:id="colCantidad" text="Cantidad" minWidth="70" maxWidth="100"/>
                                    <TableColumn fx:id="colPrecio" text="Precio" minWidth="70" maxWidth="100"/>
                                    <TableColumn fx:id="colIVA" text="IVA %" minWidth="60" maxWidth="80"/>
                                    <TableColumn fx:id="colSubtotal" text="Subtotal" minWidth="80" maxWidth="100"/>
                                </columns>
                            </TableView>

                            <HBox spacing="10">
                                <Button text="Eliminar linea" onAction="#onEliminarLinea" styleClass="button-danger"/>
                            </HBox>
                        </VBox>

                        <HBox spacing="14" alignment="TOP_LEFT">
                            <VBox styleClass="form-section" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <Label text="Albaranes relacionados" styleClass="section-title"/>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="txtBuscarAlbaran" promptText="Buscar albaran por numero..." HBox.hgrow="ALWAYS"/>
                                    <Button text="Buscar" onAction="#onBuscarAlbaran" styleClass="button"/>
                                </HBox>

                                <Label text="Disponibles" styleClass="form-label"/>
                                <TableView fx:id="tableAlbaranesDisponibles" prefHeight="130">
                                    <columns>
                                        <TableColumn fx:id="colAlbNumero" text="Numero"/>
                                        <TableColumn fx:id="colAlbFecha" text="Fecha"/>
                                        <TableColumn fx:id="colAlbTotal" text="Total"/>
                                    </columns>
                                </TableView>

                                <HBox spacing="10">
                                    <Button text="Vincular" onAction="#onVincularAlbaran" styleClass="button-primary"/>
                                    <Button text="Desvincular" onAction="#onDesvincularAlbaran" styleClass="button-danger"/>
                                </HBox>

                                <Label text="Vinculados" styleClass="form-label"/>
                                <TableView fx:id="tableAlbaranesVinculados" prefHeight="110">
                                    <columns>
                                        <TableColumn fx:id="colVincNumero" text="Numero"/>
                                        <TableColumn fx:id="colVincFecha" text="Fecha"/>
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox styleClass="form-section" prefWidth="320">
                                <Label text="Totales" styleClass="section-title"/>
                                <GridPane styleClass="form-grid">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="55"/>
                                        <ColumnConstraints percentWidth="45"/>
                                    </columnConstraints>

                                    <Label text="Base imponible" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="form-label"/>
                                    <Label fx:id="lblBaseImponible" text="0.00 EUR" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="total-label"/>

                                    <Label text="IVA" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="form-label"/>
                                    <Label fx:id="lblIVA" text="0.00 EUR" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="total-label"/>

                                    <Separator GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2"/>

                                    <Label text="TOTAL" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="total-label"/>
                                    <Label fx:id="lblTotalFactura" text="0.00 EUR" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="money-total"/>
                                </GridPane>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </center>

            <bottom>
                <HBox styleClass="form-footer">
                    <Button text="Cancelar" onAction="#onCancelar" styleClass="button"/>
                    <Button text="Guardar borrador" onAction="#onGuardarBorrador" styleClass="button"/>
                    <Button text="Emitir factura" onAction="#onEmitir" styleClass="button-success"/>
                </HBox>
            </bottom>
        </BorderPane>
    </content>
</ScrollPane>
