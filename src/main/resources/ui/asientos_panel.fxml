<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.AsientoContableController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="ASIENTOS CONTABLES" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refrescar" onAction="#onRefresh" styleClass="button"/>
        <Button text="+ Nuevo Asiento" onAction="#onNuevo" styleClass="button-success"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="Buscar asiento..." HBox.hgrow="ALWAYS" style="-fx-min-height: 40px;"/>
        <DatePicker fx:id="dpFechaDesde" promptText="Desde"/>
        <DatePicker fx:id="dpFechaHasta" promptText="Hasta"/>
        <Button text="Buscar" onAction="#onBuscar" styleClass="button-primary"/>
    </HBox>

    <TableView fx:id="tableAsientos" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="colNumero" text="Número" minWidth="70" maxWidth="100"/>
            <TableColumn fx:id="colFecha" text="Fecha" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="colConcepto" text="Concepto" minWidth="200"/>
            <TableColumn fx:id="colDebe" text="Debe" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="colHaber" text="Haber" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="colDescuadre" text="Descuadre" minWidth="80" maxWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Ver" onAction="#onVer" styleClass="button"/>
        <Button text="Editar" onAction="#onEditar" styleClass="button-primary"/>
        <Button text="Eliminar" onAction="#onEliminar" styleClass="button-danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 asientos" style="-fx-text-fill: #6c757d;"/>
    </HBox>

</VBox>

