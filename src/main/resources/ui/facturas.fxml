<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  MODERN & RESPONSIVE LAYOUT
  - Root: AnchorPane for a flexible UI container.
  - Structure: A main VBox organizes the view, with a SplitPane separating the master (list) and detail (form) views.
  - Content Panels: Both the master and detail views are organized into 'cards' for a clean, modern look.
  - Forms: All forms now use GridPane for proper alignment and a responsive interface.
  - Styling: All inline styles have been removed. All styling is managed via 'styles.css'.
-->
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.FacturaController"
            styleClass="page-view"
            stylesheets="@/css/styles.css">
    <VBox AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">

        <!-- HEADER -->
        <VBox styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📄" styleClass="header-icon"/>
                    <Label text="Gestión de Facturas" styleClass="header-title"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Quick Stats -->
                <HBox spacing="15" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="2" styleClass="badge-info">
                        <Label text="Total Facturas" styleClass="badge-title"/>
                        <Label text="0" styleClass="badge-value"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2" styleClass="badge-success">
                        <Label text="Pagadas" styleClass="badge-title"/>
                        <Label text="0" styleClass="badge-value"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2" styleClass="badge-warning">
                        <Label text="Pendientes" styleClass="badge-title"/>
                        <Label text="0" styleClass="badge-value"/>
                    </VBox>
                </HBox>
                <Separator orientation="VERTICAL"/>
                <Button text="← Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
            </HBox>
        </VBox>

        <!-- MAIN CONTENT -->
        <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS" styleClass="page-content">
            <!-- Left Panel: Filters & Table -->
            <VBox spacing="20">
                <!-- Filters Panel -->
                <VBox styleClass="card">
                     <Label text="🔍 Búsqueda y Filtros" styleClass="section-title"/>
                    <VBox spacing="15" styleClass="filters-panel">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Buscar:" styleClass="form-label"/>
                            <TextField fx:id="txtSearch" promptText="Número, cliente..." HBox.hgrow="ALWAYS" styleClass="search-field"/>
                        </HBox>
                        <GridPane hgap="15" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints minWidth="90" prefWidth="90"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                                <ColumnConstraints minWidth="90" prefWidth="90"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Fecha desde:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <DatePicker fx:id="dpFechaDesde" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Fecha hasta:" styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            <DatePicker fx:id="dpFechaHasta" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                            <Label text="Cliente:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <ComboBox fx:id="cboClienteFiltro" promptText="Todos" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="Estado:" styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            <ComboBox fx:id="cboEstadoFiltro" promptText="Todos" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        </GridPane>
                        <HBox spacing="10" alignment="CENTER_RIGHT">
                             <Button text="✨ Aplicar Filtros" styleClass="btn-primary"/>
                             <Button text="⟳ Limpiar" styleClass="btn-secondary"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Invoices Table -->
                <VBox styleClass="card" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📋 Lista de Facturas" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Mostrando 0 facturas" styleClass="text-muted"/>
                    </HBox>
                    <TableView fx:id="tableFacturas" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colNumero" text="Número" prefWidth="120"/>
                            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="110"/>
                            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="250"/>
                            <TableColumn fx:id="colTotal" text="Total" prefWidth="120"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10" styleClass="placeholder">
                                <Label text="🤷‍♂️" styleClass="placeholder-icon"/>
                                <Label text="No hay facturas para mostrar" styleClass="placeholder-title"/>
                                <Label text="Pruebe a cambiar los filtros o cree una nueva factura" styleClass="placeholder-text"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>

            <!-- Right Panel: Form -->
            <AnchorPane>
                <VBox spacing="20" styleClass="card" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📝" styleClass="header-icon"/>
                        <Label text="Detalles de la Factura" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblEstadoFactura" text="NUEVA" styleClass="badge-info"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane-form">
                        <VBox spacing="20">
                            <VBox spacing="15" styleClass="sub-card">
                                <Label text="📋 Información General" styleClass="subsection-title"/>
                                <GridPane hgap="15" vgap="15">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="100" prefWidth="100"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="Número:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <TextField fx:id="txtNumero" promptText="F-2025-0001" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                    <Label text="Fecha:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                    <DatePicker fx:id="dpFecha" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    <Label text="Cliente:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                    <ComboBox fx:id="cboCliente" promptText="Seleccione un cliente" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                </GridPane>
                            </VBox>
                            <VBox spacing="15" styleClass="sub-card">
                                <Label text="💰 Importes" styleClass="subsection-title"/>
                                <GridPane hgap="15" vgap="15">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="100" prefWidth="100"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="Total:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <TextField fx:id="txtTotal" editable="false" text="0.00 €" styleClass="total-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                    <Label text="Pagado:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                    <TextField fx:id="txtPagado" promptText="0.00 €" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    <Label text="Pendiente:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                    <TextField fx:id="txtPendiente" editable="false" text="0.00 €" styleClass="pending-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                </GridPane>
                            </VBox>
                            <VBox spacing="10" styleClass="sub-card">
                                <Label text="📝 Observaciones" styleClass="subsection-title"/>
                                <TextArea fx:id="txtObservaciones" promptText="Notas adicionales sobre la factura..." wrapText="true" prefRowCount="4"/>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="main-actions">
                        <Button text="➕ Nuevo" onAction="#handleNuevo" styleClass="btn-primary"/>
                        <Button text="💾 Guardar" onAction="#handleGuardar" styleClass="btn-success"/>
                        <Button text="🗑️ Eliminar" onAction="#handleEliminar" styleClass="btn-danger"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="📋 Ver Líneas" styleClass="btn-info"/>
                        <Button text="🖨️ Imprimir" onAction="#handleImprimirFactura" styleClass="btn-info"/>
                    </HBox>
                </VBox>
            </AnchorPane>
        </SplitPane>

        <!-- FOOTER -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="footer">
            <Label text="💡 Tip: Haga doble clic en una fila para editar la factura" styleClass="footer-text"/>
            <Separator orientation="VERTICAL"/>
            <Label text="Última sincronización: --:--" styleClass="footer-text"/>
        </HBox>
    </VBox>
</AnchorPane>
