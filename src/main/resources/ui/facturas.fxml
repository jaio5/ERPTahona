<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.FacturaController"
            prefHeight="800.0" prefWidth="1400.0"
            stylesheets="@../css/styles.css">

    <!-- HEADER -->
    <top>
        <VBox styleClass="header">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📄" style="-fx-font-size: 24px;"/>
                    <Label text="Gestión de Facturas" styleClass="header-title"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Estadísticas Rápidas -->
                <HBox spacing="15" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="2" styleClass="badge-info"
                          style="-fx-padding: 8 15; -fx-background-radius: 8;">
                        <Label text="Total Facturas" style="-fx-font-size: 10px; -fx-text-fill: #0c5460;"/>
                        <Label text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0c5460;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="2" styleClass="badge-success"
                          style="-fx-padding: 8 15; -fx-background-radius: 8;">
                        <Label text="Pagadas" style="-fx-font-size: 10px; -fx-text-fill: #155724;"/>
                        <Label text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #155724;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="2" styleClass="badge-warning"
                          style="-fx-padding: 8 15; -fx-background-radius: 8;">
                        <Label text="Pendientes" style="-fx-font-size: 10px; -fx-text-fill: #856404;"/>
                        <Label text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #856404;"/>
                    </VBox>
                </HBox>

                <Separator orientation="VERTICAL" style="-fx-background-color: rgba(255,255,255,0.3); -fx-pref-height: 40;"/>

                <Button text="← Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </top>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <SplitPane dividerPositions="0.6">
            <!-- PANEL IZQUIERDO: Tabla y Filtros -->
            <VBox spacing="15" style="-fx-background-color: white;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <!-- PANEL DE BÚSQUEDA Y FILTROS -->
                <VBox spacing="15" styleClass="filters-panel">
                    <Label text="🔍 Búsqueda y Filtros" styleClass="subsection-title"/>

                    <!-- Barra de Búsqueda -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Buscar:" style="-fx-min-width: 80; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtSearch" promptText="Número de factura, cliente..."
                                   HBox.hgrow="ALWAYS" styleClass="search-field"/>
                        <Button text="🔍 Buscar" onAction="#handleSearch" styleClass="btn-primary"/>
                        <Button text="🔄 Limpiar" onAction="#handleSearch" styleClass="btn-secondary"/>
                    </HBox>

                    <!-- Filtros Avanzados -->
                    <GridPane hgap="15" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="80" prefWidth="80"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
                            <ColumnConstraints minWidth="80" prefWidth="80"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
                        </columnConstraints>

                        <Label text="Fecha desde:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                               style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="dpFechaDesde" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                    maxWidth="Infinity"/>

                        <Label text="Fecha hasta:" GridPane.columnIndex="2" GridPane.rowIndex="0"
                               style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="dpFechaHasta" GridPane.columnIndex="3" GridPane.rowIndex="0"
                                    maxWidth="Infinity"/>

                        <Label text="Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                               style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="cboClienteFiltro" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                  maxWidth="Infinity" promptText="Todos los clientes"/>

                        <Label text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="1"
                               style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="cboEstadoFiltro" GridPane.columnIndex="3" GridPane.rowIndex="1"
                                  maxWidth="Infinity" promptText="Todos los estados"/>
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Aplicar Filtros" styleClass="btn-success"/>
                        <Button text="Limpiar Filtros" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>

                <!-- TABLA DE FACTURAS -->
                <VBox VBox.vgrow="ALWAYS" spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📋 Lista de Facturas" styleClass="subsection-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Mostrando 0 facturas" styleClass="text-muted text-sm"/>
                    </HBox>

                    <TableView fx:id="tableFacturas" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colNumero" text="Número" prefWidth="120"/>
                            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="110"/>
                            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="250"/>
                            <TableColumn fx:id="colTotal" text="Total" prefWidth="120"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10">
                                <Label text="📋" style="-fx-font-size: 48px; -fx-text-fill: #bdc3c7;"/>
                                <Label text="No hay facturas para mostrar"
                                       style="-fx-text-fill: #95a5a6; -fx-font-size: 14px;"/>
                                <Label text="Cree una nueva factura para comenzar"
                                       style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px;"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- ACCIONES RÁPIDAS -->
                <HBox spacing="10" alignment="CENTER">
                    <Button text="➕ Nueva Factura" onAction="#handleNuevaFactura"
                            styleClass="btn-success" prefWidth="150"/>
                    <Button text="📄 Copiar Anterior" onAction="#handleCopiarFacturaAnterior"
                            styleClass="btn-info" prefWidth="150"/>
                    <Button text="🖨️ Imprimir" onAction="#handleImprimirFactura"
                            styleClass="btn-primary" prefWidth="150"/>
                    <Button text="👁️ Previsualizar" onAction="#handlePrevisualizarFactura"
                            styleClass="btn-secondary" prefWidth="150"/>
                </HBox>
            </VBox>

            <!-- PANEL DERECHO: Formulario -->
            <VBox spacing="20" style="-fx-background-color: white;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <!-- Título del Formulario -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📝" style="-fx-font-size: 20px;"/>
                    <Label text="Detalles de la Factura" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblEstadoFactura" text="NUEVA" styleClass="badge-info"
                           style="-fx-font-size: 12px;"/>
                </HBox>

                <Separator/>

                <!-- Formulario con Scroll -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent;">
                    <VBox spacing="20">
                        <!-- Información General -->
                        <VBox spacing="15">
                            <Label text="📋 Información General" styleClass="subsection-title"/>

                            <GridPane hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="120" prefWidth="120"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Número:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <TextField fx:id="txtNumero" promptText="F-2025-0001"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="Fecha:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                       style="-fx-font-weight: bold;"/>
                                <DatePicker fx:id="dpFecha" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                            maxWidth="Infinity"/>

                                <Label text="Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                       style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="cboCliente" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                          maxWidth="Infinity" promptText="Seleccione un cliente"/>
                            </GridPane>
                        </VBox>

                        <Separator/>

                        <!-- Importes -->
                        <VBox spacing="15">
                            <Label text="💰 Importes" styleClass="subsection-title"/>

                            <GridPane hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="120" prefWidth="120"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Total:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <TextField fx:id="txtTotal" editable="false" styleClass="total-field"
                                           text="0.00 €" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="Pagado:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                       style="-fx-font-weight: bold;"/>
                                <TextField fx:id="txtPagado" promptText="0.00 €"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="Pendiente:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                       style="-fx-font-weight: bold;"/>
                                <TextField fx:id="txtPendiente" editable="false"
                                           text="0.00 €" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                           style="-fx-background-color: #fff3cd; -fx-border-color: #f39c12;"/>
                            </GridPane>
                        </VBox>

                        <Separator/>

                        <!-- Observaciones -->
                        <VBox spacing="10">
                            <Label text="📝 Observaciones" styleClass="subsection-title"/>
                            <TextArea fx:id="txtObservaciones" prefRowCount="4"
                                      promptText="Notas adicionales sobre la factura..."
                                      wrapText="true"/>
                        </VBox>

                        <!-- Info Box -->
                        <VBox spacing="8" styleClass="info-box">
                            <Label text="ℹ️ Información Importante" styleClass="info-title"/>
                            <Label text="• Los cambios se guardan automáticamente"
                                   styleClass="info-text" wrapText="true"/>
                            <Label text="• Puede editar las líneas después de crear la factura"
                                   styleClass="info-text" wrapText="true"/>
                            <Label text="• El total se calcula automáticamente"
                                   styleClass="info-text" wrapText="true"/>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <Separator/>

                <!-- Botones de Acción -->
                <VBox spacing="12">
                    <!-- Acciones Principales -->
                    <HBox spacing="10" alignment="CENTER">
                        <Button text="💾 Guardar" onAction="#handleGuardar"
                                styleClass="btn-success" prefWidth="160"/>
                        <Button text="🗑️ Eliminar" onAction="#handleEliminar"
                                styleClass="btn-danger" prefWidth="160"/>
                    </HBox>

                    <!-- Acciones Secundarias -->
                    <HBox spacing="10" alignment="CENTER">
                        <Button text="📋 Ver Líneas"
                                styleClass="btn-info" prefWidth="160"/>
                        <Button text="🔄 Nuevo" onAction="#handleNuevo"
                                styleClass="btn-secondary" prefWidth="160"/>
                    </HBox>
                </VBox>
            </VBox>
        </SplitPane>
    </center>

    <!-- BARRA INFERIOR -->
    <bottom>
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="footer">
            <Label text="💡 Tip: Haga doble clic en una fila para editar" styleClass="footer-text"/>
            <Separator orientation="VERTICAL"/>
            <Label text="Última actualización: --:--" styleClass="footer-text"/>
        </HBox>
    </bottom>
</BorderPane>