<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.ClienteController"
      stylesheets="@/styles/simple-theme.css"
      styleClass="screen"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox styleClass="screen-header">
        <VBox spacing="2">
            <Label text="Clientes" styleClass="title"/>
            <Label text="Ficha fiscal, contacto y condiciones de venta." styleClass="subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refrescar" onAction="#onRefresh" styleClass="button"/>
        <Button text="Nuevo cliente" onAction="#onNuevo" styleClass="button-success"/>
    </HBox>

    <HBox styleClass="screen-toolbar">
        <TextField fx:id="txtBuscar" promptText="Buscar cliente..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="cmbActivo" promptText="Estado" minWidth="120" maxWidth="150"/>
        <Button text="Buscar" onAction="#onBuscarCliente" styleClass="button-primary"/>
    </HBox>

    <TableView fx:id="tableClientes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" text="Codigo" minWidth="70" maxWidth="100"/>
            <TableColumn fx:id="colNombre" text="Nombre" minWidth="150"/>
            <TableColumn fx:id="colCIF" text="CIF/NIF" minWidth="80" maxWidth="120"/>
            <TableColumn fx:id="colDireccion" text="Direccion" minWidth="150"/>
            <TableColumn fx:id="colPoblacion" text="Poblacion" minWidth="100"/>
            <TableColumn fx:id="colProvincia" text="Provincia" minWidth="100"/>
            <TableColumn fx:id="colActivo" text="Activo" minWidth="60" maxWidth="80"/>
        </columns>
    </TableView>

    <HBox styleClass="screen-footer">
        <Button text="Ver" onAction="#onVerCliente" styleClass="button"/>
        <Button text="Editar" onAction="#onEditar" styleClass="button-primary"/>
        <Button text="Dar de baja" onAction="#onDarBajaCliente" styleClass="button-danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 clientes" styleClass="muted"/>
    </HBox>

</VBox>
