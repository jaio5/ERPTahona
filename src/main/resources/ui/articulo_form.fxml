<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="15" prefWidth="500" prefHeight="500">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="Datos del Artículo" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <GridPane hgap="10" vgap="15">
        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Código del artículo"/>
        <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtDescripcion" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Descripción del artículo"/>
        <Label text="Familia:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtFamilia" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="Familia o categoría"/>
        <Label text="Unidad:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtUnidad" GridPane.columnIndex="1" GridPane.rowIndex="3" promptText="UND, KG, etc."/>
        <Label text="IVA (%):" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="txtIva" GridPane.columnIndex="1" GridPane.rowIndex="4" promptText="21.00"/>
        <Label text="PVP (€):" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="txtPvp" GridPane.columnIndex="1" GridPane.rowIndex="5" promptText="0.00"/>
        <Label text="Coste (€):" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <TextField fx:id="txtCoste" GridPane.columnIndex="1" GridPane.rowIndex="6" promptText="0.00"/>
    </GridPane>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnGuardar" text="Guardar" defaultButton="true" styleClass="btn-primary"/>
        <Button fx:id="btnCancelar" text="Cancelar" cancelButton="true" styleClass="btn-secondary"/>
    </HBox>
</VBox>
