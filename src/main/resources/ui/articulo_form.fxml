<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.formcontroller.ArticuloFormController"
            stylesheets="@/styles/simple-theme.css"
            fitToWidth="true" fitToHeight="true">
    <content>
        <BorderPane styleClass="form-root">
            <top>
                <HBox styleClass="form-header">
                    <VBox spacing="2">
                        <Label fx:id="lblTitulo" text="Nuevo articulo" styleClass="title"/>
                        <Label text="Producto, precio, impuestos y stock." styleClass="subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="* obligatorio" styleClass="muted"/>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true">
                    <VBox styleClass="form-body">
                        <VBox styleClass="form-section">
                            <Label text="Datos principales" styleClass="section-title"/>
                            <GridPane styleClass="form-grid">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="25"/>
                                </columnConstraints>

                                <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Codigo *" styleClass="form-label"/>
                                    <TextField fx:id="txtCodigo" promptText="ART001"/>
                                    <Label fx:id="lblErrCodigo" styleClass="form-error"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Nombre *" styleClass="form-label"/>
                                    <TextField fx:id="txtNombre" promptText="Nombre del articulo"/>
                                    <Label fx:id="lblErrNombre" styleClass="form-error"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="Codigo de barras" styleClass="form-label"/>
                                    <TextField fx:id="txtCodigoBarras" promptText="EAN13"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="3">
                                    <Label text="Descripcion" styleClass="form-label"/>
                                    <TextArea fx:id="txtDescripcion" promptText="Descripcion detallada del articulo..." prefRowCount="2" wrapText="true"/>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <VBox styleClass="form-section">
                            <Label text="Clasificacion" styleClass="section-title"/>
                            <GridPane styleClass="form-grid">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="33.33"/>
                                    <ColumnConstraints percentWidth="33.33"/>
                                    <ColumnConstraints percentWidth="33.33"/>
                                </columnConstraints>

                                <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Categoria" styleClass="form-label"/>
                                    <ComboBox fx:id="cbCategoria" promptText="Seleccionar" maxWidth="Infinity"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Familia" styleClass="form-label"/>
                                    <ComboBox fx:id="cbFamilia" promptText="Seleccionar" maxWidth="Infinity"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="Unidad de medida" styleClass="form-label"/>
                                    <ComboBox fx:id="cbUnidadMedida" promptText="Unidad" maxWidth="Infinity"/>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <VBox styleClass="form-section">
                            <Label text="Precios e impuestos" styleClass="section-title"/>
                            <GridPane styleClass="form-grid">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                </columnConstraints>

                                <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Precio compra" styleClass="form-label"/>
                                    <TextField fx:id="txtPrecioCompra" text="0.00" promptText="0.00"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Precio venta *" styleClass="form-label"/>
                                    <TextField fx:id="txtPrecioVenta" text="0.00" promptText="0.00"/>
                                    <Label fx:id="lblErrPrecioVenta" styleClass="form-error"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="IVA (%)" styleClass="form-label"/>
                                    <ComboBox fx:id="cbIva" promptText="21%" maxWidth="Infinity"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                    <Label text="Margen (%)" styleClass="form-label"/>
                                    <TextField fx:id="txtMargen" text="0.00" editable="false" styleClass="readonly-field"/>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <VBox styleClass="form-section">
                            <Label text="Stock e inventario" styleClass="section-title"/>
                            <GridPane styleClass="form-grid">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="25"/>
                                </columnConstraints>

                                <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Stock actual" styleClass="form-label"/>
                                    <TextField fx:id="txtStockActual" text="0"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Stock minimo" styleClass="form-label"/>
                                    <TextField fx:id="txtStockMinimo" text="0"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="Stock maximo" styleClass="form-label"/>
                                    <TextField fx:id="txtStockMaximo" text="0"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                    <Label text="Punto pedido" styleClass="form-label"/>
                                    <TextField fx:id="txtPuntoPedido" text="0"/>
                                </VBox>
                            </GridPane>

                            <HBox spacing="18">
                                <CheckBox fx:id="chkControlStock" text="Controlar stock" selected="true"/>
                                <CheckBox fx:id="chkActivo" text="Articulo activo" selected="true"/>
                            </HBox>

                            <VBox spacing="8" style="-fx-padding: 8 0 0 0;">
                                <Label text="Alérgenos" styleClass="form-label"/>
                                <Label text="Separados por comas. Obligatorio UE 1169/2011." styleClass="muted"/>
                                <TextField fx:id="txtAlergenos" promptText="Gluten, Huevos, Leche, Frutos de cáscara..."/>
                                <Label text="14 alérgenos UE: Gluten, Crustáceos, Huevos, Pescado, Cacahuetes, Soja, Leche, Frutos de cáscara, Apio, Mostaza, Sésamo, Sulfitos, Altramuces, Moluscos" style="-fx-font-size: 9px; -fx-text-fill: #888;"/>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </center>

            <bottom>
                <HBox styleClass="form-footer">
                    <Button text="Cancelar" onAction="#onCancelar" styleClass="button"/>
                    <Button fx:id="btnGuardarArticulo" text="Guardar articulo" onAction="#onGuardar" styleClass="button-success"/>
                </HBox>
            </bottom>
        </BorderPane>
    </content>
</ScrollPane>
