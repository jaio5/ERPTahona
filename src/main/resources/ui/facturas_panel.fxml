<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.FacturaController"
      stylesheets="@/styles/simple-theme.css"
      styleClass="screen"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox styleClass="screen-header">
        <VBox spacing="2">
            <Label text="Facturas de venta" styleClass="title"/>
            <Label text="Emision, rectificativas y seguimiento VeriFactu." styleClass="subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refrescar" onAction="#onRefresh" styleClass="button"/>
        <Button text="Nueva factura" onAction="#onNuevo" styleClass="button-success"/>
        <Button text="Rectificativa" onAction="#onCrearRectificativa" styleClass="button-primary"/>
    </HBox>

    <HBox styleClass="screen-toolbar">
        <TextField fx:id="txtBuscar" promptText="Buscar factura..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="cmbEstado" promptText="Estado" minWidth="110" maxWidth="150"/>
        <DatePicker fx:id="dpFechaDesde" promptText="Desde"/>
        <DatePicker fx:id="dpFechaHasta" promptText="Hasta"/>
        <Button text="Buscar" onAction="#onBuscarFactura" styleClass="button-primary"/>
    </HBox>

    <TableView fx:id="tableFacturas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumero" text="Numero" minWidth="80" maxWidth="120"/>
            <TableColumn fx:id="colFecha" text="Fecha" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="colCliente" text="Cliente" minWidth="150"/>
            <TableColumn fx:id="colBase" text="Base" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="colIVA" text="IVA" minWidth="60" maxWidth="80"/>
            <TableColumn fx:id="colTotal" text="Total" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="colEstado" text="Estado" minWidth="80" maxWidth="100"/>
        </columns>
    </TableView>

    <HBox styleClass="screen-footer">
        <Button text="Ver" onAction="#onVerFactura" styleClass="button"/>
        <Button text="Editar" onAction="#onEditar" styleClass="button-primary"/>
        <Button text="Imprimir" onAction="#onImprimir" styleClass="button"/>
        <Button text="Anular" onAction="#onAnular" styleClass="button-danger"/>
        <Button text="Enviar AEAT" onAction="#onEnviarAeat" styleClass="button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 facturas" styleClass="muted"/>
    </HBox>

</VBox>
