<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.AuditoriaController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;">

    <!-- Título y botones principales -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="📋 Auditoría del Sistema" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄 Actualizar" onAction="#onRefresh" styleClass="button"/>
        <Button text="📊 Estadísticas" onAction="#onEstadisticas" styleClass="button"/>
    </HBox>

    <!-- Filtros -->
    <HBox spacing="12">
        <TextField fx:id="txtBuscar" promptText="🔍 Buscar..." HBox.hgrow="ALWAYS" style="-fx-min-height: 40px;"/>
        <ComboBox fx:id="cmbUsuario" promptText="Usuario" prefWidth="150"/>
        <ComboBox fx:id="cmbAccion" promptText="Acción" prefWidth="150"/>
        <ComboBox fx:id="cmbModulo" promptText="Módulo" prefWidth="150"/>
        <DatePicker fx:id="dpFechaDesde" promptText="Desde" prefWidth="130"/>
        <DatePicker fx:id="dpFechaHasta" promptText="Hasta" prefWidth="130"/>
        <Button text="Buscar" onAction="#onBuscar" styleClass="button-primary"/>
        <Button text="🗑️" onAction="#onLimpiarFiltros" styleClass="button-danger"/>
    </HBox>

    <!-- Tabla -->
    <VBox VBox.vgrow="ALWAYS">
        <TableView fx:id="tableAuditoria" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
            <columns>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150"/>
                <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="120"/>
                <TableColumn fx:id="colAccion" text="Acción" prefWidth="120"/>
                <TableColumn fx:id="colModulo" text="Módulo" prefWidth="120"/>
                <TableColumn fx:id="colEntidad" text="Entidad" prefWidth="120"/>
                <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="300"/>
                <TableColumn fx:id="colResultado" text="Estado" prefWidth="100"/>
                <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="80"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Footer -->
    <HBox spacing="12">
        <Button text="👁️ Ver Detalles" onAction="#onVerDetalles" styleClass="button"/>
        <Button text="🔍 Filtro Rápido" onAction="#onFiltroRapido" styleClass="button"/>
        <Button text="📤 Exportar" onAction="#onExportar" styleClass="button-primary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 registros" style="-fx-text-fill: #6c757d;"/>
        <Label text="|" style="-fx-text-fill: #dee2e6;"/>
        <Label fx:id="lblEstadisticas" text="Estadísticas" style="-fx-text-fill: #6c757d;"/>
        <Label text="|" style="-fx-text-fill: #dee2e6;"/>
        <Label fx:id="lblSeleccion" text="Selección" style="-fx-text-fill: #6c757d;"/>
    </HBox>

</VBox>

