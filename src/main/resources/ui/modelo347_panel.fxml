<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.NormativaController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="📊 Modelo 347" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📊 Generar Modelo" onAction="#onGenerar" styleClass="button-success"/>
    </HBox>

    <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
        <Label text="Configuración" style="-fx-font-weight: 600; -fx-font-size: 14;"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Ejercicio:" minWidth="100"/>
            <ComboBox fx:id="cmbEjercicio" minWidth="120" maxWidth="180"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Umbral:" minWidth="100"/>
            <TextField fx:id="txtUmbral" text="3005.06" maxWidth="150"/>
            <Label text="€"/>
        </HBox>
    </VBox>

    <TableView fx:id="tableOperaciones" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white;" >
        <columns>
            <TableColumn fx:id="colCIF" text="CIF/NIF" minWidth="80" maxWidth="120"/>
            <TableColumn fx:id="colNombre" text="Nombre" minWidth="150"/>
            <TableColumn fx:id="colImporte" text="Importe" minWidth="80" maxWidth="120"/>
            <TableColumn fx:id="colTrimestre" text="Trimestre" minWidth="70" maxWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="📄 Exportar" onAction="#onExportar" styleClass="button-primary"/>
        <Button text="📋 Informe" onAction="#onInforme" styleClass="button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 operaciones" style="-fx-text-fill: #6c757d;"/>
    </HBox>

</VBox>

