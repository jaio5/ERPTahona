<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.VerifactuController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="VeriFacTur" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblEstado" text="● Deshabilitado" style="-fx-text-fill: #6c757d;"/>
    </HBox>

    <VBox styleClass="card" spacing="16">
        <Label text="Configuración" style="-fx-font-weight: 600; -fx-font-size: 16;"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Estado:" prefWidth="150"/>
            <CheckBox fx:id="chkHabilitado" text="Habilitado"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Certificado:" prefWidth="150"/>
            <TextField fx:id="txtCertificado" HBox.hgrow="ALWAYS" promptText="Ruta del certificado"/>
            <Button text="..." onAction="#onSeleccionarCertificado" styleClass="button"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Contraseña:" prefWidth="150"/>
            <PasswordField fx:id="txtPassword" prefWidth="200"/>
        </HBox>

        <HBox spacing="12">
            <Button text="💾 Guardar" onAction="#onGuardar" styleClass="button-success"/>
            <Button text="🧪 Probar Conexión" onAction="#onProbar" styleClass="button-primary"/>
        </HBox>
    </VBox>

    <VBox VBox.vgrow="ALWAYS">
        <Label text="Registro de Envíos" style="-fx-font-weight: 600; -fx-font-size: 15;"/>
        <TableView fx:id="tableEnvios" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="120"/>
                <TableColumn fx:id="colFactura" text="Factura" prefWidth="120"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                <TableColumn fx:id="colMensaje" text="Mensaje" prefWidth="300"/>
            </columns>
        </TableView>
    </VBox>

</VBox>

