<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.VerifactuController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="VERI*FACTU AEAT" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblEstado" text="NO VERI*FACTU" style="-fx-text-fill: #6c757d;"/>
        <Button text="Actualizar" onAction="#onRefresh" styleClass="button"/>
    </HBox>

    <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
        <Label text="Configuracion legal de funcionamiento" style="-fx-font-weight: 600; -fx-font-size: 14;"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Modo:" minWidth="120"/>
            <Label fx:id="lblModoLegal" text="NO VERI*FACTU" style="-fx-font-weight: 600;"/>
        </HBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Inicio:" minWidth="120"/>
            <Label fx:id="lblFechaInicio" text="-"/>
        </HBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Renuncia:" minWidth="120"/>
            <Label fx:id="lblFechaRenuncia" text="-"/>
        </HBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="NIF:" minWidth="120"/>
            <TextField fx:id="txtNif" maxWidth="200"/>
        </HBox>

        <HBox spacing="12">
            <Button fx:id="btnGuardar" text="Guardar datos" onAction="#onGuardar" styleClass="button"/>
            <Button fx:id="btnIniciar" text="Iniciar VERI*FACTU" onAction="#onIniciarVerifactu" styleClass="button-success"/>
            <Button fx:id="btnRenuncia" text="Programar renuncia 31/12" onAction="#onProgramarRenuncia" styleClass="button-secondary"/>
            <Button fx:id="btnProbar" text="Probar AEAT" onAction="#onProbar" styleClass="button-primary"/>
        </HBox>
    </VBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnEnviar" text="Emitir facturas" onAction="#onEnviar" styleClass="button-primary"/>
        <Button text="Verificar" onAction="#onVerificar" styleClass="button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblInfo" text="0 pendientes" style="-fx-text-fill: #6c757d;"/>
        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="20" prefHeight="20"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" spacing="12">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Registro de envios" style="-fx-font-weight: 600;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtBuscar" promptText="Buscar factura..." prefWidth="220"
                       style="-fx-padding: 6 10;"/>
        </HBox>
        <TableView fx:id="tableEnvios" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: white;">
            <columns>
                <TableColumn fx:id="colFecha" text="Fecha" minWidth="100" maxWidth="140"/>
                <TableColumn fx:id="colFactura" text="Factura" minWidth="80" maxWidth="120"/>
                <TableColumn fx:id="colCliente" text="Cliente" minWidth="120"/>
                <TableColumn fx:id="colImporte" text="Importe" minWidth="70" maxWidth="100"/>
                <TableColumn fx:id="colEstado" text="Estado" minWidth="80" maxWidth="120"/>
                <TableColumn fx:id="colReferencia" text="Referencia" minWidth="100"/>
                <TableColumn fx:id="colMensaje" text="Mensaje" minWidth="150"/>
            </columns>
        </TableView>
    </VBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Ver" onAction="#onVerDetalles" styleClass="button"/>
        <Button text="Reenviar" onAction="#onReenviar" styleClass="button"/>
        <Button text="Exportar" onAction="#onExportar" styleClass="button-primary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 registros" style="-fx-text-fill: #6c757d;"/>
    </HBox>

</VBox>
