<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.AuditoriaController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <!-- Título y botones principales -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="📋 Auditoría del Sistema" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄" onAction="#onRefresh" styleClass="button" style="-fx-font-size: 16;"/>
        <Button text="📊 Estadísticas" onAction="#onEstadisticas" styleClass="button-primary"/>
    </HBox>

    <!-- Filtros -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="🔍 Buscar..." HBox.hgrow="ALWAYS" style="-fx-min-height: 40px;"/>
        <ComboBox fx:id="cmbUsuario" promptText="Usuario" minWidth="90" maxWidth="140"/>
        <ComboBox fx:id="cmbAccion" promptText="Acción" minWidth="90" maxWidth="140"/>
        <ComboBox fx:id="cmbModulo" promptText="Módulo" minWidth="90" maxWidth="140"/>
        <DatePicker fx:id="dpFechaDesde" promptText="Desde" minWidth="110" maxWidth="140"/>
        <DatePicker fx:id="dpFechaHasta" promptText="Hasta" minWidth="110" maxWidth="140"/>
        <Button text="Buscar" onAction="#onBuscar" styleClass="button-primary"/>
        <Button text="🗑️" onAction="#onLimpiarFiltros" styleClass="button-danger"/>
    </HBox>

    <!-- Tabla -->
    <TableView fx:id="tableAuditoria" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white;" >
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" minWidth="100" maxWidth="150"/>
            <TableColumn fx:id="colUsuario" text="Usuario" minWidth="80" maxWidth="120"/>
            <TableColumn fx:id="colAccion" text="Acción" minWidth="70" maxWidth="120"/>
            <TableColumn fx:id="colModulo" text="Módulo" minWidth="70" maxWidth="120"/>
            <TableColumn fx:id="colEntidad" text="Entidad" minWidth="70" maxWidth="120"/>
            <TableColumn fx:id="colDescripcion" text="Descripción" minWidth="150"/>
            <TableColumn fx:id="colResultado" text="Estado" minWidth="60" maxWidth="100"/>
            <TableColumn fx:id="colAcciones" text="Acciones" minWidth="60" maxWidth="80"/>
        </columns>
    </TableView>

    <!-- Footer -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="👁️ Ver" onAction="#onVerDetalles" styleClass="button"/>
        <Button text="🔍 Filtro" onAction="#onFiltroRapido" styleClass="button"/>
        <Button text="📤 Exportar" onAction="#onExportar" styleClass="button-primary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 registros" style="-fx-text-fill: #6c757d;"/>
        <Label fx:id="lblEstadisticas" style="-fx-text-fill: #6c757d;"/>
        <Label fx:id="lblSeleccion" style="-fx-text-fill: #6c757d;"/>
    </HBox>

</VBox>

