<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.ClienteController" prefWidth="1000" prefHeight="700">
    <top>
        <HBox spacing="8" padding="10">
            <Label text="Clientes" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtSearch" promptText="Buscar nombre..." />
            <Button text="Buscar" onAction="#handleSearch" />
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.6">
            <VBox spacing="8" padding="10">
                <TableView fx:id="tableClientes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" text="Código" prefWidth="120" />
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="300" />
                        <TableColumn fx:id="colPoblacion" text="Población" prefWidth="200" />
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="8" padding="10">
                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="120" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="Código:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <TextField fx:id="txtCodigo" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                    <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                    <Label text="CIF:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <TextField fx:id="txtCif" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                    <Label text="Dirección:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <TextField fx:id="txtDireccion" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                    <Label text="Población:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                    <TextField fx:id="txtPoblacion" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                    <Label text="Código postal:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                    <TextField fx:id="txtCodigoPostal" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                    <Label text="Provincia:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                    <TextField fx:id="txtProvincia" GridPane.rowIndex="6" GridPane.columnIndex="1" />

                    <Label text="Notas:" GridPane.rowIndex="7" GridPane.columnIndex="0" />
                    <TextArea fx:id="txtNotas" GridPane.rowIndex="7" GridPane.columnIndex="1" prefRowCount="4" />
                </GridPane>

                <HBox spacing="10" alignment="CENTER" padding="10">
                    <Button text="Nuevo" onAction="#handleNuevo" />
                    <Button text="Guardar" onAction="#handleGuardar" />
                    <Button text="Eliminar" onAction="#handleEliminar" />
                </HBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>

