<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.ClienteController"
            prefHeight="750.0" prefWidth="1300.0">

    <!-- Header -->
    <top>
        <VBox styleClass="header">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Gestión de Clientes" styleClass="header-title">
                    <font><Font name="System Bold" size="22"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center - Split View -->
    <center>
        <SplitPane dividerPositions="0.55">
            <!-- Left: Table and Filters -->
            <VBox spacing="10">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <!-- Filters Panel -->
                <VBox spacing="8" styleClass="filters-panel">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>

                    <!-- Search Bar -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Buscar:">
                            <font><Font name="System Bold" size="12"/></font>
                        </Label>
                        <TextField fx:id="txtSearch" promptText="Código, nombre o CIF..."
                                   HBox.hgrow="ALWAYS"/>
                        <Button text="Buscar" onAction="#handleSearch" styleClass="btn-primary"/>
                    </HBox>

                    <!-- Filter by Provincia -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Provincia:">
                            <font><Font name="System Bold" size="12"/></font>
                        </Label>
                        <ComboBox fx:id="cboProvincia" prefWidth="150"/>
                        <Button text="Aplicar" onAction="#handleFilterProvincia"
                                styleClass="btn-success"/>
                    </HBox>
                </VBox>

                <!-- Table -->
                <TableView fx:id="tableClientes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" text="Código" prefWidth="100"/>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="250"/>
                        <TableColumn fx:id="colCif" text="CIF" prefWidth="110"/>
                        <TableColumn fx:id="colPoblacion" text="Población" prefWidth="150"/>
                        <TableColumn fx:id="colProvincia" text="Prov." prefWidth="60"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right: Form -->
            <VBox spacing="15">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <!-- Form Title -->
                <Label text="Datos del Cliente" styleClass="section-title">
                    <font><Font name="System Bold" size="16"/></font>
                </Label>

                <Separator/>

                <!-- Form Fields -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <VBox spacing="15">
                        <padding>
                            <Insets top="5" right="5" bottom="5" left="5"/>
                        </padding>

                        <!-- Datos Identificativos -->
                        <VBox spacing="5">
                            <Label text="Datos Identificativos" styleClass="subsection-title">
                                <font><Font name="System Bold" size="13"/></font>
                            </Label>
                            <Separator/>
                        </VBox>

                        <GridPane hgap="10" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints minWidth="100" prefWidth="100"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <!-- Código -->
                            <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <TextField fx:id="txtCodigo" promptText="0001"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <!-- Nombre -->
                            <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <TextField fx:id="txtNombre" promptText="Nombre completo"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <!-- CIF -->
                            <Label text="CIF:" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <TextField fx:id="txtCif" promptText="CIF/NIF"
                                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <!-- Dirección -->
                            <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <TextField fx:id="txtDireccion" promptText="Dirección"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <!-- Población -->
                            <Label text="Población:" GridPane.columnIndex="0" GridPane.rowIndex="4">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <TextField fx:id="txtPoblacion" promptText="Población"
                                       GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                            <!-- Código Postal -->
                            <Label text="Código Postal:" GridPane.columnIndex="0" GridPane.rowIndex="5">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <TextField fx:id="txtCodigoPostal" promptText="Código Postal"
                                       GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                            <!-- Provincia -->
                            <Label text="Provincia:" GridPane.columnIndex="0" GridPane.rowIndex="6">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <TextField fx:id="txtProvincia" promptText="Provincia"
                                       GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                            <!-- Notas -->
                            <Label text="Notas:" GridPane.columnIndex="0" GridPane.rowIndex="7">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <TextArea fx:id="txtNotas" promptText="Notas"
                                      GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                        </GridPane>
                    </VBox>
                </ScrollPane>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>