<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  MODERN & RESPONSIVE LAYOUT
  - Root: AnchorPane for a flexible UI container.
  - Structure: A main VBox holds the header, content (SplitPane), and footer.
  - Form (Right): The client data form is rebuilt with a GridPane for a clean, aligned, and responsive interface.
  - Styling: All inline styles and the <font> tag are removed. Styling is managed via '''styles.css'''.
-->
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.ClienteController"
            styleClass="page-view"
            stylesheets="@/css/styles.css">
    <VBox AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <!-- HEADER -->
        <VBox styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="👤" styleClass="header-icon"/>
                    <Label text="Gestión de Clientes" styleClass="header-title"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
            </HBox>
        </VBox>

        <!-- MAIN CONTENT -->
        <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS" styleClass="page-content">
            <!-- Left Panel: Table and Filters -->
            <VBox spacing="15" styleClass="card">
                <VBox spacing="15" styleClass="filters-panel">
                    <Label text="🔎 Búsqueda y Filtros" styleClass="subsection-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Buscar:" styleClass="form-label"/>
                        <TextField fx:id="txtSearch" promptText="Código, nombre, CIF..." HBox.hgrow="ALWAYS" styleClass="search-field"/>
                        <Button text="🔎 Buscar" onAction="#handleSearch" styleClass="btn-primary"/>
                        <Button text="⟳ Limpiar" onAction="#handleSearch" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>
                <TableView fx:id="tableClientes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" text="Código" prefWidth="100"/>
                        <TableColumn fx:id="colNombre" text="Nombre/Razón Social" prefWidth="250"/>
                        <TableColumn fx:id="colCif" text="CIF/NIF" prefWidth="110"/>
                        <TableColumn fx:id="colPoblacion" text="Población" prefWidth="150"/>
                        <TableColumn fx:id="colProvincia" text="Provincia" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right Panel: Form -->
            <AnchorPane>
                <VBox spacing="20" styleClass="card" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
                    <Label text="📝 Datos del Cliente" styleClass="section-title"/>
                    <GridPane hgap="10" vgap="15" VBox.vgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="120.0"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        
                        <Label text="Código:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtCodigo" promptText="Código del cliente" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        
                        <Label text="Nombre:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtNombre" promptText="Nombre o razón social" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        
                        <Label text="CIF/NIF:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtCif" promptText="CIF o NIF" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        
                        <Label text="Población:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtPoblacion" promptText="Población" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        
                        <Label text="Provincia:" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtProvincia" promptText="Provincia" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        
                        <rowConstraints>
                           <RowConstraints/>
                           <RowConstraints/>
                           <RowConstraints/>
                           <RowConstraints/>
                           <RowConstraints/>
                           <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        </rowConstraints>
                    </GridPane>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="main-actions">
                        <Button text="➕ Nuevo" onAction="#handleNuevo" styleClass="btn-primary"/>
                        <Button text="💾 Guardar" onAction="#handleGuardar" styleClass="btn-success"/>
                        <Button text="🗑 Eliminar" onAction="#handleEliminar" styleClass="btn-danger"/>
                    </HBox>
                </VBox>
            </AnchorPane>
        </SplitPane>

        <!-- FOOTER -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="footer">
            <Label text="💡 Tip: Haga doble clic en una fila para editar" styleClass="footer-text"/>
            <Separator orientation="VERTICAL"/>
            <Label text="Use el filtro para búsquedas rápidas" styleClass="footer-text"/>
        </HBox>
    </VBox>
</AnchorPane>
