<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.formcontroller.ClienteFormController"
            stylesheets="@/styles/simple-theme.css"
            fitToWidth="true" fitToHeight="true">
    <content>
        <BorderPane styleClass="form-root">
            <top>
                <HBox styleClass="form-header">
                    <VBox spacing="2">
                        <Label fx:id="lblTitulo" text="Nuevo cliente" styleClass="title"/>
                        <Label text="Datos fiscales, contacto y condiciones comerciales." styleClass="subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnDirecciones" text="Direcciones" styleClass="button"/>
                    <Label text="* obligatorio" styleClass="muted"/>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true">
                    <VBox styleClass="form-body">
                        <VBox styleClass="form-section">
                            <Label text="Datos principales" styleClass="section-title"/>
                            <GridPane styleClass="form-grid">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="25"/>
                                </columnConstraints>

                                <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Codigo" styleClass="form-label"/>
                                    <TextField fx:id="txtCodigo" promptText="Auto" editable="false" styleClass="readonly-field"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Nombre / razon social *" styleClass="form-label"/>
                                    <TextField fx:id="txtNombre" promptText="Nombre completo o razon social"/>
                                    <Label fx:id="lblErrNombre" styleClass="form-error"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="CIF / NIF *" styleClass="form-label"/>
                                    <TextField fx:id="txtCIF" promptText="B12345678"/>
                                    <Button fx:id="btnBuscarDatosEmpresa" text="Buscar datos" onAction="#onBuscarDatosEmpresa" styleClass="button-primary"/>
                                    <Label fx:id="lblErrCIF" styleClass="form-error"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="Telefono" styleClass="form-label"/>
                                    <TextField fx:id="txtTelefono" promptText="600 123 456"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="Email" styleClass="form-label"/>
                                    <TextField fx:id="txtEmail" promptText="cliente@email.com"/>
                                    <Label fx:id="lblErrEmail" styleClass="form-error"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                    <Label text="Estado" styleClass="form-label"/>
                                    <CheckBox fx:id="chkActivo" text="Cliente activo" selected="true"/>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <VBox styleClass="form-section">
                            <Label text="Direccion" styleClass="section-title"/>
                            <GridPane styleClass="form-grid">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="55"/>
                                    <ColumnConstraints percentWidth="15"/>
                                    <ColumnConstraints percentWidth="30"/>
                                </columnConstraints>

                                <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Direccion" styleClass="form-label"/>
                                    <TextField fx:id="txtDireccion" promptText="Calle, numero, piso, puerta..."/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="CP" styleClass="form-label"/>
                                    <TextField fx:id="txtCodigoPostal" promptText="03001"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="Poblacion" styleClass="form-label"/>
                                    <TextField fx:id="txtPoblacion" promptText="Alicante"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="3">
                                    <Label text="Provincia" styleClass="form-label"/>
                                    <ComboBox fx:id="cbProvincia" promptText="Seleccionar" maxWidth="Infinity"/>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <VBox styleClass="form-section">
                            <Label text="Condiciones comerciales" styleClass="section-title"/>
                            <GridPane styleClass="form-grid">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="33.33"/>
                                    <ColumnConstraints percentWidth="33.33"/>
                                    <ColumnConstraints percentWidth="33.33"/>
                                </columnConstraints>

                                <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Forma de pago" styleClass="form-label"/>
                                    <ComboBox fx:id="cbFormaPago" promptText="Seleccionar" maxWidth="Infinity"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Dias de credito" styleClass="form-label"/>
                                    <TextField fx:id="txtDiasCredito" text="0" promptText="30"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="Descuento (%)" styleClass="form-label"/>
                                    <TextField fx:id="txtDescuento" text="0.00" promptText="0.00"/>
                                </VBox>

                                <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="3">
                                    <Label text="Notas" styleClass="form-label"/>
                                    <TextArea fx:id="txtNotas" promptText="Observaciones sobre el cliente..." prefRowCount="3" wrapText="true"/>
                                </VBox>
                            </GridPane>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </center>

            <bottom>
                <HBox styleClass="form-footer">
                    <Button text="Cancelar" onAction="#onCancelar" styleClass="button"/>
                    <Button fx:id="btnGuardar" text="Guardar cliente" onAction="#onGuardar" styleClass="button-success"/>
                </HBox>
            </bottom>
        </BorderPane>
    </content>
</ScrollPane>
