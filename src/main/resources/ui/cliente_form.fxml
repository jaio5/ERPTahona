<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="15" prefWidth="500" prefHeight="500">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="Datos del Cliente" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <GridPane hgap="10" vgap="15">
        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Código del cliente"/>
        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Nombre o razón social"/>
        <Label text="CIF/NIF:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtCif" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="CIF/NIF"/>
        <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtDireccion" GridPane.columnIndex="1" GridPane.rowIndex="3" promptText="Dirección completa"/>
        <Label text="Población:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="txtPoblacion" GridPane.columnIndex="1" GridPane.rowIndex="4" promptText="Ciudad o población"/>
        <Label text="Código Postal:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="txtCodigoPostal" GridPane.columnIndex="1" GridPane.rowIndex="5" promptText="CP"/>
        <Label text="Provincia:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <TextField fx:id="txtProvincia" GridPane.columnIndex="1" GridPane.rowIndex="6" promptText="Provincia"/>
        <Label text="Notas:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <TextArea fx:id="txtNotas" GridPane.columnIndex="1" GridPane.rowIndex="7" promptText="Notas adicionales" prefRowCount="3"/>
    </GridPane>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnGuardar" text="Guardar" defaultButton="true" styleClass="btn-primary"/>
        <Button fx:id="btnCancelar" text="Cancelar" cancelButton="true" styleClass="btn-secondary"/>
    </HBox>
</VBox>
