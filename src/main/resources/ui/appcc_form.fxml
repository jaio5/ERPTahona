<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.formcontroller.AppccFormController"
      spacing="12" style="-fx-padding: 24; -fx-background-color: #f8f9fa;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <Label text="CONTROL APPCC" styleClass="title"/>

    <GridPane hgap="12" vgap="8">
        <padding><Insets top="10" right="0" bottom="10" left="0"/></padding>
        <Label text="Fecha:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpFecha" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Punto Crítico:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbPuntoCritico" editable="true" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Descripción:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDescripcion" promptText="Descripción del control" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Temperatura:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTemperatura" promptText="Temperatura medida (°C)" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Límite crítico:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtLimiteCritico" promptText="Límite permitido (°C)" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Resultado:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbResultado" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Acción correctiva:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextArea fx:id="txtAccionCorrectiva" promptText="Acción tomada si no conforme" prefRowCount="2" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Responsable:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="txtResponsable" promptText="Persona que realizó el control" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#onCancelar" styleClass="button"/>
        <Button text="Guardar" onAction="#onGuardar" styleClass="button-success"/>
    </HBox>
</VBox>
