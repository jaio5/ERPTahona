<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.FacturaCompraController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="🧾 Facturas de Compra" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄" onAction="#onRefresh" styleClass="button" style="-fx-font-size: 16;"/>
        <Button text="+ Nueva Factura" onAction="#onNuevo" styleClass="button-success"/>
    </HBox>

    <HBox spacing="12" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="🔍 Buscar por número o proveedor..." HBox.hgrow="ALWAYS" style="-fx-min-height: 40px;"/>
        <ComboBox fx:id="cmbEstado" promptText="Estado" minWidth="100" maxWidth="140"/>
        <DatePicker fx:id="dpFechaDesde" promptText="Desde" minWidth="110" maxWidth="140"/>
        <DatePicker fx:id="dpFechaHasta" promptText="Hasta" minWidth="110" maxWidth="140"/>
        <Button text="Buscar" onAction="#onBuscar" styleClass="button-primary"/>
    </HBox>

    <TableView fx:id="tableFacturas" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white;" >
        <columns>
            <TableColumn fx:id="colNumero" text="Número" minWidth="80" maxWidth="120"/>
            <TableColumn fx:id="colFecha" text="Fecha" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="colProveedor" text="Proveedor" minWidth="150"/>
            <TableColumn fx:id="colBase" text="Base" minWidth="80" maxWidth="120"/>
            <TableColumn fx:id="colTotal" text="Total" minWidth="80" maxWidth="120"/>
            <TableColumn fx:id="colEstado" text="Estado" minWidth="80" maxWidth="120"/>
        </columns>
        <placeholder>
            <Label text="🧾 No hay facturas de compra registradas" style="-fx-text-fill: #6c757d;"/>
        </placeholder>
    </TableView>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="👁️ Ver" onAction="#onVer" styleClass="button"/>
        <Button text="✏️ Editar" onAction="#onEditar" styleClass="button-primary"/>
        <Button text="💰 Contabilizar" onAction="#onContabilizar" styleClass="button-success"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 facturas" style="-fx-text-fill: #6c757d;"/>
    </HBox>

</VBox>

