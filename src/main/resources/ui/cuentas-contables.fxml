<?xml version="1.0" encoding="UTF-8"?>
gi<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="alicanteweb.erp.controller.CuentaContableController"
            prefHeight="800.0" prefWidth="1400.0" stylesheets="/css/styles.css">
    <!-- Header -->
    <top>
        <VBox styleClass="header">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="💼" style="-fx-font-size: 24px;"/>
                    <Label text="Cuentas contables" styleClass="header-title"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.6">
            <!-- Left: Table -->
            <VBox spacing="15" style="-fx-background-color: white;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <TableView fx:id="tableCuentas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" text="Código"/>
                        <TableColumn fx:id="colNombre" text="Nombre"/>
                        <TableColumn fx:id="colTipo" text="Tipo"/>
                    </columns>
                </TableView>
            </VBox>
            <!-- Right: Form -->
            <VBox spacing="15" style="-fx-background-color: #f8f9fa;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Datos de la Cuenta" styleClass="section-title">
                        <font><Font name="System Bold" size="16"/></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <VBox spacing="12">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Código:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtCodigo" promptText="Código"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Nombre:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtNombre" promptText="Nombre"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Tipo:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtTipo" promptText="Tipo"/>
                    </HBox>
                </VBox>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="main-actions">
                    <Button text="➕ Nuevo" onAction="#handleNuevo" styleClass="btn-primary"/>
                    <Button text="💾 Guardar" onAction="#handleGuardar" styleClass="btn-success"/>
                    <Button text="🗑 Eliminar" onAction="#handleEliminar" styleClass="btn-danger"/>
                </HBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
