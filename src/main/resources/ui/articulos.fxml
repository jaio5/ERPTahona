<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.ArticuloController"
            prefHeight="800.0" prefWidth="1400.0"
            stylesheets="/css/styles.css">
    <!-- Header -->
    <top>
        <VBox styleClass="header">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🛒" style="-fx-font-size: 24px;"/>
                    <Label text="Gestión de Artículos" styleClass="header-title"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.6">
            <!-- Left: Table and Filters -->
            <VBox spacing="15" style="-fx-background-color: white;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <VBox spacing="15" styleClass="filters-panel">
                    <Label text="🔎 Búsqueda y Filtros" styleClass="subsection-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Buscar:" style="-fx-min-width: 80; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtSearch" promptText="Código o descripción..."
                                   HBox.hgrow="ALWAYS" styleClass="search-field"/>
                        <Button text="🔎 Buscar" onAction="#handleSearch" styleClass="btn-primary"/>
                        <Button text="⟳ Limpiar" onAction="#handleSearch" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>
                <TableView fx:id="tableArticulos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" text="Código" prefWidth="100"/>
                        <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="280"/>
                        <TableColumn fx:id="colFamilia" text="Familia" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
            <!-- Right: Form -->
            <VBox spacing="15" style="-fx-background-color: #f8f9fa;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Datos del Artículo" styleClass="section-title">
                        <font><Font name="System Bold" size="16"/></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <VBox spacing="12">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Código:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtCodigo" promptText="0100"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Descripción:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtDescripcion" promptText="Descripción del artículo"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Familia:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtFamilia" promptText="01"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Unidad:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtUnidad" promptText="Kg, Ud, L..."/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="PVP (€):" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtPvp" promptText="0.00 €"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Coste (€):" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtCoste" promptText="0.00 €"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="IVA (%):" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtIva" promptText="21.00 %"/>
                    </HBox>
                </VBox>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="main-actions">
                    <Button text="➕ Nuevo" onAction="#handleNuevo" styleClass="btn-primary"/>
                    <Button text="💾 Guardar" onAction="#handleGuardar" styleClass="btn-success"/>
                    <Button text="🗑 Eliminar" onAction="#handleEliminar" styleClass="btn-danger"/>
                </HBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>