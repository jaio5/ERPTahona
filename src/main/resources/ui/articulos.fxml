<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  MODERN & RESPONSIVE LAYOUT
  - Root: AnchorPane for a flexible UI container.
  - Structure: VBox for the main layout, with a SplitPane for the master-detail view.
  - Form (Right): The data form is rebuilt with a GridPane for a clean, aligned, and responsive interface.
  - Styling: All inline styles removed. All styling is managed via '''styles.css'''.
-->
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.ArticuloController"
            styleClass="page-view"
            stylesheets="@/css/styles.css">
    <VBox AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <!-- Header -->
        <VBox styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🛒" styleClass="header-icon"/>
                    <Label text="Gestión de Artículos" styleClass="header-title"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
            </HBox>
        </VBox>

        <!-- Main Content -->
        <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS" styleClass="page-content">
            <!-- Left Panel: Table and Filters -->
            <VBox spacing="15" styleClass="card">
                <VBox spacing="15" styleClass="filters-panel">
                    <Label text="🔎 Búsqueda y Filtros" styleClass="subsection-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Buscar:" styleClass="form-label"/>
                        <TextField fx:id="txtSearch" promptText="Código o descripción..." HBox.hgrow="ALWAYS" styleClass="search-field"/>
                        <Button text="🔎 Buscar" onAction="#handleSearch" styleClass="btn-primary"/>
                        <Button text="⟳ Limpiar" onAction="#handleSearch" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>
                <TableView fx:id="tableArticulos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" text="Código" prefWidth="100"/>
                        <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="280"/>
                        <TableColumn fx:id="colFamilia" text="Familia" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right Panel: Form -->
            <AnchorPane>
                <VBox spacing="20" styleClass="card" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
                    <Label text="📝 Datos del Artículo" styleClass="section-title"/>
                    <GridPane hgap="10" vgap="15" VBox.vgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" prefWidth="100.0"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Código:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtCodigo" promptText="Ej: 0100" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Descripción:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtDescripcion" promptText="Descripción del artículo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Familia:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtFamilia" promptText="Ej: 01" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Unidad:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtUnidad" promptText="Kg, Ud, L..." GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="PVP (€):" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtPvp" promptText="0.00" alignment="CENTER_RIGHT" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Coste (€):" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtCoste" promptText="0.00" alignment="CENTER_RIGHT" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="IVA (%):" styleClass="form-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtIva" promptText="21.00" alignment="CENTER_RIGHT" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                        
                        <rowConstraints>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        </rowConstraints>
                    </GridPane>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="main-actions">
                        <Button text="➕ Nuevo" onAction="#handleNuevo" styleClass="btn-primary"/>
                        <Button text="💾 Guardar" onAction="#handleGuardar" styleClass="btn-success"/>
                        <Button text="🗑 Eliminar" onAction="#handleEliminar" styleClass="btn-danger"/>
                    </HBox>
                </VBox>
            </AnchorPane>
        </SplitPane>
    </VBox>
</AnchorPane>
