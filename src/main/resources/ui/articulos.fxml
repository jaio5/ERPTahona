<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.ArticuloController"
            prefHeight="750.0" prefWidth="1300.0">
    <top>
        <VBox>
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Gestión de Artículos"/>
                <Pane/>
                <Button text="← Volver" onAction="#handleVolver"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.58">
            <VBox spacing="10">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                <VBox spacing="8">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Buscar:"/>
                        <TextField fx:id="txtSearch" promptText="Código o descripción..."/>
                        <Button text="Buscar" onAction="#handleSearch"/>
                    </HBox>
                </VBox>
                <TableView fx:id="tableArticulos">
                    <columns>
                        <TableColumn fx:id="colCodigo" text="Código" prefWidth="100"/>
                        <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="280"/>
                        <TableColumn fx:id="colFamilia" text="Familia" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
            <VBox spacing="15">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Datos del Artículo"/>
                    <Pane/>
                </HBox>
                <Separator/>
                <ScrollPane fitToWidth="true">
                    <VBox spacing="15">
                        <padding>
                            <Insets top="5" right="5" bottom="5" left="5"/>
                        </padding>
                        <GridPane hgap="10" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints minWidth="100" prefWidth="100"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField fx:id="txtCodigo" promptText="0100" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <TextField fx:id="txtDescripcion" promptText="Descripción del artículo" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="Familia:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <TextField fx:id="txtFamilia" promptText="01" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <Label text="Unidad:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <TextField fx:id="txtUnidad" promptText="Kg, Ud, L..." GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                            <Label text="PVP (€):" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <TextField fx:id="txtPvp" promptText="0.00 €" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                            <Label text="Coste (€):" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                            <TextField fx:id="txtCoste" promptText="0.00 €" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                            <Label text="IVA (%):" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                            <TextField fx:id="txtIva" promptText="21.00 %" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                        </GridPane>
                        <VBox spacing="8">
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>
                            <Label text="ℹ Tipos de IVA habituales"/>
                            <Label text="IVA General: 21%"/>
                            <Label text="IVA Reducido: 10%"/>
                            <Label text="IVA Superreducido: 4%"/>
                        </VBox>
                    </VBox>
                </ScrollPane>
                <Separator/>
                <VBox spacing="10">
                    <HBox spacing="10" alignment="CENTER">
                        <Button text="Nuevo" onAction="#handleNuevo" prefWidth="130"/>
                        <Button text="Guardar" onAction="#handleGuardar" prefWidth="130"/>
                        <Button text="Eliminar" onAction="#handleEliminar" prefWidth="130"/>
                    </HBox>
                </VBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>