<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
================================================================
 FXML REFACTORIZADO Y MEJORADO
================================================================
- Hoja de estilos externa: Se utiliza "styles_mejorado.css".
- Clases CSS: Se eliminaron todos los estilos en línea ("style=...")
  y se reemplazaron por styleClass.
- Bienvenida modernizada: Las tarjetas de acceso rápido ahora usan
  VBox con vgrow="ALWAYS" para alinear el link "Acceder" en la
  parte inferior, logrando un diseño más limpio y adaptable.
================================================================
-->

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.ui.MainPanelController"
            prefHeight="800.0" prefWidth="1400.0"
            stylesheets="@../css/styles_mejorado.css">

    <!-- ======================= HEADER ======================= -->
    <top>
        <VBox styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <!-- Logo y Título -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🍞" styleClass="icon-sm"/>
                    <VBox>
                        <Label text="ERP Panadería Tahona" styleClass="header-title"/>
                        <Label text="Sistema de Gestión Integral" styleClass="header-subtitle"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Info Usuario y Menú -->
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label fx:id="lblUsuario" text="👤 Usuario Admin" styleClass="header-user-label"/>
                        <Label fx:id="lblFechaHora" text="📅 26 Nov 2025, 14:30" styleClass="header-subtitle"/>
                    </VBox>

                    <Separator orientation="VERTICAL" styleClass="header-separator"/>

                    <MenuBar>
                        <Menu text="⚙️ Sistema">
                            <MenuItem text="Configuración" onAction="#onConfiguracion"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Salir" onAction="#onExit"/>
                        </Menu>
                        <Menu text="❓ Ayuda">
                            <MenuItem text="Manual de Usuario" onAction="#onManual"/>
                            <MenuItem text="Acerca de..." onAction="#onAbout"/>
                        </Menu>
                    </MenuBar>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ======================= NAVEGACIÓN LATERAL ======================= -->
    <left>
        <VBox styleClass="left-sidebar" prefWidth="240" maxWidth="240">

            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="nav-header">
                <Label text="📋" styleClass="icon-xs"/>
                <Label text="NAVEGACIÓN" styleClass="nav-title-text"/>
            </HBox>

            <Separator/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox spacing="8">
                    <!-- Sección Ventas -->
                    <VBox spacing="6">
                        <Label text="💰 VENTAS" styleClass="nav-section-title"/>
                        <Button text="📄 Facturas" onAction="#onNavFactura" styleClass="btn-outline-primary", "nav-button" prefWidth="210"/>
                        <Button text="📦 Albaranes Venta" onAction="#onNavAlbaranesVenta" styleClass="btn-outline-primary", "nav-button" prefWidth="210"/>
                        <Button text="📋 Pedidos" onAction="#onNavPedidos" styleClass="btn-outline-primary", "nav-button" prefWidth="210"/>
                    </VBox>

                    <Separator styleClass="nav-separator"/>

                    <!-- Sección Maestros -->
                    <VBox spacing="6">
                        <Label text="📚 MAESTROS" styleClass="nav-section-title"/>
                        <Button text="👥 Clientes" onAction="#onNavClientes" styleClass="btn-outline-primary", "nav-button" prefWidth="210"/>
                        <Button text="🏭 Proveedores" onAction="#onNavProveedores" styleClass="btn-outline-primary", "nav-button" prefWidth="210"/>
                        <Button text="🍞 Artículos" onAction="#onNavArticulos" styleClass="btn-outline-primary", "nav-button" prefWidth="210"/>
                        <Button text="🏪 Almacenes" onAction="#onNavAlmacenes" styleClass="btn-outline-primary", "nav-button" prefWidth="210"/>
                    </VBox>

                    <Separator styleClass="nav-separator"/>

                    <!-- Sección Complementos -->
                    <VBox spacing="6">
                        <Label text="🔧 COMPLEMENTOS" styleClass="nav-section-title"/>
                        <Button text="📍 Direcciones Envío" onAction="#onNavDireccionesEnvio" styleClass="btn-outline-primary", "nav-button" prefWidth="210"/>
                        <Button text="📊 Líneas Factura" onAction="#onNavFacturaLineas" styleClass="btn-outline-primary", "nav-button" prefWidth="210"/>
                        <Button text="📊 Líneas Pedido" onAction="#onNavPedidoLineas" styleClass="btn-outline-primary", "nav-button" prefWidth="210"/>
                    </VBox>

                    <Separator styleClass="nav-separator"/>

                    <!-- Sección Sistema -->
                    <VBox spacing="6">
                        <Label text="🔐 SISTEMA" styleClass="nav-section-title"/>
                        <Button text="🔐 Verifactu Evidence" onAction="#onNavVerifactuEvidence" styleClass="btn-outline-primary", "nav-button" prefWidth="210"/>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- Ayuda Rápida -->
            <VBox spacing="10" style="-fx-padding: 15 0 0 0;">
                <Separator/>
                <Button text="❓ Ayuda Rápida" onAction="#onManual" styleClass="btn-info" prefWidth="210"/>
            </VBox>
        </VBox>
    </left>

    <!-- ======================= CONTENIDO PRINCIPAL ======================= -->
    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane">

            <!-- Pantalla de Bienvenida -->
            <VBox fx:id="welcomeScreen" alignment="CENTER" spacing="25">
                <VBox alignment="CENTER" spacing="20" styleClass="welcome-card-main">
                    <Label text="🍞" styleClass="icon-lg"/>
                    <Label text="Bienvenido al ERP Panadería Tahona" styleClass="welcome-title", "text-primary"/>
                    <Label text="Sistema Integrado de Gestión Empresarial" styleClass="welcome-subtitle", "text-muted"/>
                    <Separator prefWidth="400" styleClass="welcome-separator"/>

                    <!-- Accesos Rápidos -->
                    <VBox spacing="25">
                        <Label text="⚡ Accesos Rápidos" styleClass="text-md", "text-primary"/>
                        <GridPane hgap="20" vgap="20" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="180.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="180.0" vgrow="SOMETIMES" />
                            </rowConstraints>

                            <!-- Card Facturas -->
                            <VBox onMouseClicked="#onNavFactura" styleClass="card", "quick-access-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="📄" styleClass="icon-md"/>
                                <Label text="Facturas" styleClass="quick-access-title", "text-primary"/>
                                <Label text="Gestión de facturación y cobros" styleClass="quick-access-description", "text-muted", "text-sm"/>
                                <Region VBox.vgrow="ALWAYS"/>
                                <Label text="→ Acceder" styleClass="quick-access-link"/>
                            </VBox>

                            <!-- Card Clientes -->
                            <VBox onMouseClicked="#onNavClientes" styleClass="card", "quick-access-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="👥" styleClass="icon-md"/>
                                <Label text="Clientes" styleClass="quick-access-title", "text-primary"/>
                                <Label text="Administra la base de clientes" styleClass="quick-access-description", "text-muted", "text-sm"/>
                                <Region VBox.vgrow="ALWAYS"/>
                                <Label text="→ Acceder" styleClass="quick-access-link"/>
                            </VBox>

                            <!-- Card Artículos -->
                            <VBox onMouseClicked="#onNavArticulos" styleClass="card", "quick-access-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="🍞" styleClass="icon-md"/>
                                <Label text="Artículos" styleClass="quick-access-title", "text-primary"/>
                                <Label text="Catálogo de productos y precios" styleClass="quick-access-description", "text-muted", "text-sm"/>
                                <Region VBox.vgrow="ALWAYS"/>
                                <Label text="→ Acceder" styleClass="quick-access-link"/>
                            </VBox>

                            <!-- Card Albaranes -->
                            <VBox onMouseClicked="#onNavAlbaranesVenta" styleClass="card", "quick-access-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="📦" styleClass="icon-md"/>
                                <Label text="Albaranes" styleClass="quick-access-title", "text-primary"/>
                                <Label text="Control de entregas y salidas" styleClass="quick-access-description", "text-muted", "text-sm"/>
                                <Region VBox.vgrow="ALWAYS"/>
                                <Label text="→ Acceder" styleClass="quick-access-link"/>
                            </VBox>

                            <!-- Card Almacenes -->
                            <VBox onMouseClicked="#onNavAlmacenes" styleClass="card", "quick-access-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="🏪" styleClass="icon-md"/>
                                <Label text="Almacenes" styleClass="quick-access-title", "text-primary"/>
                                <Label text="Gestión de inventario y stock" styleClass="quick-access-description", "text-muted", "text-sm"/>
                                <Region VBox.vgrow="ALWAYS"/>
                                <Label text="→ Acceder" styleClass="quick-access-link"/>
                            </VBox>

                            <!-- Card Pedidos -->
                            <VBox onMouseClicked="#onNavPedidos" styleClass="card", "quick-access-card" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                <Label text="📋" styleClass="icon-md"/>
                                <Label text="Pedidos" styleClass="quick-access-title", "text-primary"/>
                                <Label text="Control de pedidos de clientes" styleClass="quick-access-description", "text-muted", "text-sm"/>
                                <Region VBox.vgrow="ALWAYS"/>
                                <Label text="→ Acceder" styleClass="quick-access-link"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                </VBox>

                <!-- Tips y Versión -->
                <HBox spacing="30" alignment="CENTER">
                    <Label text="💡 Tip: Usa Ctrl+Click para abrir módulos en una nueva ventana." styleClass="tip-text"/>
                    <Label text="•" styleClass="text-muted"/>
                    <Label text="Versión 1.0.0" styleClass="tip-text"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>

    <!-- ======================= FOOTER ======================= -->
    <bottom>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="footer">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="✓" styleClass="footer-status-icon-ok"/>
                <Label text="Sistema operativo" styleClass="footer-status-text-ok"/>
            </HBox>
            <Separator orientation="VERTICAL" styleClass="footer-separator"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="●" styleClass="footer-db-status-icon"/>
                <Label fx:id="lblEstadoDB" text="Base de datos: Conectada" styleClass="footer-db-status-text"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="ERP Panadería Tahona © 2025 | Todos los derechos reservados" styleClass="footer-text"/>
        </HBox>
    </bottom>
</BorderPane>
