<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.ui.MainPanelController">
    <top>
        <MenuBar>
            <menus>
                <Menu text="Archivo">
                    <items>
                        <MenuItem text="Salir" onAction="#onExit"/>
                    </items>
                </Menu>
                <Menu text="Ayuda">
                    <items>
                        <MenuItem text="Acerca de" onAction="#onAbout"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <left>
        <VBox spacing="8" style="-fx-padding:10;">
            <Label fx:id="titleLabel" text="ERP" style="-fx-font-size:16px; -fx-font-weight:bold;"/>
            <Separator/>
            <Button text="Facturas" onAction="#onNavFactura" maxWidth="Infinity"/>
            <Button text="Clientes" onAction="#onNavClientes" maxWidth="Infinity"/>
            <Button text="Artículos" onAction="#onNavArticulos" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" style="-fx-padding:10;" />
    </center>
</BorderPane>
