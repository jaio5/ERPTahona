<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="alicanteweb.erp.controller.ui.MainPanelController"
            stylesheets="@/css/main_panel.css"
            prefHeight="800.0"
            prefWidth="1400.0">

    <!-- ==================== CABECERA PREMIUM ==================== -->
    <top>
        <HBox styleClass="header-box" alignment="CENTER">
            <Label text="🥖 ERP Panadería" styleClass="header-label"/>
        </HBox>
    </top>

    <!-- ==================== BARRA LATERAL MODERNA ==================== -->
    <left>
        <HBox>
            <VBox spacing="12" styleClass="sidebar">
                <Label text="NAVEGACIÓN" styleClass="sidebar-title"/>

                <Button fx:id="btnClientes"
                        text="Clientes"
                        onAction="#onClientes">
                    <graphic>
                        <HBox alignment="CENTER" spacing="0">
                            <StackPane styleClass="icon-container-small"
                                       style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea, #764ba2); -fx-background-radius: 8; -fx-pref-width: 32; -fx-pref-height: 32;">
                                <Label text="👥" style="-fx-font-size: 16px;"/>
                            </StackPane>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnProveedores"
                        text="Proveedores"
                        onAction="#onProveedores">
                    <graphic>
                        <HBox alignment="CENTER" spacing="0">
                            <StackPane styleClass="icon-container-small"
                                       style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f093fb, #f5576c); -fx-background-radius: 8; -fx-pref-width: 32; -fx-pref-height: 32;">
                                <Label text="🏭" style="-fx-font-size: 16px;"/>
                            </StackPane>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnArticulos"
                        text="Artículos"
                        onAction="#onArticulos">
                    <graphic>
                        <HBox alignment="CENTER" spacing="0">
                            <StackPane styleClass="icon-container-small"
                                       style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #4facfe, #00f2fe); -fx-background-radius: 8; -fx-pref-width: 32; -fx-pref-height: 32;">
                                <Label text="🍞" style="-fx-font-size: 16px;"/>
                            </StackPane>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnFacturas"
                        text="Facturas"
                        onAction="#onFacturas">
                    <graphic>
                        <HBox alignment="CENTER" spacing="0">
                            <StackPane styleClass="icon-container-small"
                                       style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #43e97b, #38f9d7); -fx-background-radius: 8; -fx-pref-width: 32; -fx-pref-height: 32;">
                                <Label text="💰" style="-fx-font-size: 16px;"/>
                            </StackPane>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnAlmacenes"
                        text="Almacenes"
                        onAction="#onAlmacenes">
                    <graphic>
                        <HBox alignment="CENTER" spacing="0">
                            <StackPane styleClass="icon-container-small"
                                       style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #fa709a, #fee140); -fx-background-radius: 8; -fx-pref-width: 32; -fx-pref-height: 32;">
                                <Label text="📦" style="-fx-font-size: 16px;"/>
                            </StackPane>
                        </HBox>
                    </graphic>
                </Button>

                <Region VBox.vgrow="ALWAYS"/>

                <Separator/>

                <Button text="⚙️ Configuración"
                        style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;">
                    <graphic>
                        <Label text="" style="-fx-font-size: 0;"/>
                    </graphic>
                </Button>
            </VBox>

            <Separator orientation="VERTICAL"/>
        </HBox>
    </left>

    <!-- ==================== ÁREA CENTRAL CON CARDS ==================== -->
    <center>
        <StackPane fx:id="mainContent" styleClass="main-content">
            <GridPane fx:id="gridModulos"
                      styleClass="grid-pane"
                      hgap="48"
                      vgap="48"
                      alignment="CENTER">
                <!-- CLIENTES -->
                <Button styleClass="module-card-large" GridPane.columnIndex="0" GridPane.rowIndex="0" onAction="#onClientes">
                    <VBox styleClass="module-box-large">
                        <Label text="👥" styleClass="module-emoji" />
                        <Label text="Clientes" styleClass="module-title-large" />
                    </VBox>
                </Button>
                <!-- PROVEEDORES -->
                <Button styleClass="module-card-large" GridPane.columnIndex="1" GridPane.rowIndex="0" onAction="#onProveedores">
                    <VBox styleClass="module-box-large">
                        <Label text="🏭" styleClass="module-emoji" />
                        <Label text="Proveedores" styleClass="module-title-large" />
                    </VBox>
                </Button>
                <!-- ARTÍCULOS -->
                <Button styleClass="module-card-large" GridPane.columnIndex="0" GridPane.rowIndex="1" onAction="#onArticulos">
                    <VBox styleClass="module-box-large">
                        <Label text="🍞" styleClass="module-emoji" />
                        <Label text="Artículos" styleClass="module-title-large" />
                    </VBox>
                </Button>
                <!-- FACTURAS -->
                <Button styleClass="module-card-large" GridPane.columnIndex="1" GridPane.rowIndex="1" onAction="#onFacturas">
                    <VBox styleClass="module-box-large">
                        <Label text="💰" styleClass="module-emoji" />
                        <Label text="Facturas" styleClass="module-title-large" />
                    </VBox>
                </Button>
                <!-- ALMACENES -->
                <Button styleClass="module-card-large" GridPane.columnIndex="0" GridPane.rowIndex="2" onAction="#onAlmacenes">
                    <VBox styleClass="module-box-large">
                        <Label text="📦" styleClass="module-emoji" />
                        <Label text="Almacenes" styleClass="module-title-large" />
                    </VBox>
                </Button>
                <!-- ESTADÍSTICAS -->
                <Button styleClass="module-card-large" GridPane.columnIndex="1" GridPane.rowIndex="2" disable="true">
                    <VBox styleClass="module-box-large">
                        <Label text="📊" styleClass="module-emoji" />
                        <Label text="Estadísticas" styleClass="module-title-large" />
                    </VBox>
                </Button>
            </GridPane>
        </StackPane>
    </center>
</BorderPane>
