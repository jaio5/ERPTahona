<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.ui.MainPanelController"
            stylesheets="@/styles/simple-theme.css"
            style="-fx-background-color: #ffffff;">

    <!-- BARRA SUPERIOR -->
    <top>
        <VBox style="-fx-background-color: #1e3a5f;">
            <!-- Header con usuario -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 16 24; -fx-background-color: #1e3a5f;">
                <Label text="🏢 ERP Panadería Tahona"
                       style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: 700;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblUsuario" text="Usuario"
                       style="-fx-text-fill: white; -fx-font-size: 14;"/>
                <Button text="🚪 Salir" onAction="#onCerrarSesion"
                        style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: 600; -fx-padding: 8 16; -fx-cursor: hand;"/>
            </HBox>

            <!-- Menú de navegación -->
            <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding: 0 24 12 24; -fx-background-color: #1e3a5f;">
                <Button text="🏠 Dashboard" onAction="#onDashboard" styleClass="menu-button"/>
                <Button text="👥 Clientes" onAction="#onClientes" styleClass="menu-button"/>
                <Button text="📦 Artículos" onAction="#onArticulos" styleClass="menu-button"/>
                <Button text="🏢 Proveedores" onAction="#onProveedores" styleClass="menu-button"/>
                <Button text="📝 Facturas" onAction="#onFacturas" styleClass="menu-button"/>
                <Button text="📋 Albaranes" onAction="#onAlbaranes" styleClass="menu-button"/>

                <MenuButton text="💼 Más" styleClass="menu-button">
                    <items>
                        <MenuItem text="💰 Caja" onAction="#onCaja"/>
                        <MenuItem text="📊 Contabilidad" onAction="#onAsientos"/>
                        <MenuItem text="🏪 Almacenes" onAction="#onAlmacenes"/>
                        <MenuItem text="💵 Presupuestos" onAction="#onPresupuestos"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="📑 Facturas Compra" onAction="#onFacturasCompra"/>
                        <MenuItem text="👤 Usuarios" onAction="#onUsuarios"/>
                        <MenuItem text="📋 Auditoría" onAction="#onAuditoria"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="✅ VeriFacTur" onAction="#onVerifactu"/>
                        <MenuItem text="⚙️ Configuración" onAction="#onConfiguracion"/>
                    </items>
                </MenuButton>
            </HBox>
        </VBox>
    </top>

    <!-- CONTENIDO CENTRAL -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #f8f9fa;">
            <!-- Aquí se cargan las vistas dinámicamente -->
        </StackPane>
    </center>

    <!-- BARRA INFERIOR -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 12 24; -fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 1 0 0 0;">
            <Label text="© 2026 ERP Tahona" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblEstado" text="✅ Sistema operativo"
                   style="-fx-text-fill: #198754; -fx-font-size: 12; -fx-font-weight: 600;"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="lblFecha" text="2026-01-07" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
            <Label fx:id="lblHora" text="00:00:00" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
        </HBox>
    </bottom>

</BorderPane>

