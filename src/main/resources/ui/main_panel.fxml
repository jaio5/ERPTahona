<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.ui.MainPanelController"
            stylesheets="@/styles/simple-theme.css"
            styleClass="app-shell">

    <left>
        <ScrollPane fitToWidth="true" styleClass="sidebar-scroll"
                    VBox.vgrow="ALWAYS" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox prefWidth="238" spacing="2" styleClass="sidebar" minHeight="0"
                  style="-fx-padding: 18 14 30 14;">
            <VBox spacing="2" style="-fx-padding: 2 10 14 10;">
                <Label text="Tahona" styleClass="brand-title"/>
                <Label text="ERP de obrador y tienda" styleClass="brand-subtitle"/>
            </VBox>

            <Label text="HOY" styleClass="nav-section"/>
            <Button fx:id="btnDashboard" text="Panel" onAction="#onDashboard" styleClass="sidebar-button"/>
            <Button fx:id="btnCaja" text="Caja" onAction="#onCaja" styleClass="sidebar-button"/>

            <Label text="VENTAS" styleClass="nav-section"/>
            <Button fx:id="btnFacturas" text="Facturas" onAction="#onFacturas" styleClass="sidebar-button"/>
            <Button fx:id="btnAlbaranes" text="Albaranes" onAction="#onAlbaranes" styleClass="sidebar-button"/>
            <Button fx:id="btnPedidosVenta" text="Pedidos venta" onAction="#onPedidosVenta" styleClass="sidebar-button"/>
            <Button fx:id="btnPresupuestos" text="Presupuestos" onAction="#onPresupuestos" styleClass="sidebar-button"/>
            <Button fx:id="btnClientes" text="Clientes" onAction="#onClientes" styleClass="sidebar-button"/>

            <Label text="OPERACION" styleClass="nav-section"/>
            <Button fx:id="btnArticulos" text="Articulos" onAction="#onArticulos" styleClass="sidebar-button"/>
            <Button fx:id="btnAlmacenes" text="Almacenes" onAction="#onAlmacenes" styleClass="sidebar-button"/>
            <Button fx:id="btnProveedores" text="Proveedores" onAction="#onProveedores" styleClass="sidebar-button"/>
            <Button fx:id="btnPedidosCompra" text="Pedidos compra" onAction="#onPedidosCompra" styleClass="sidebar-button"/>
            <Button fx:id="btnFacturasCompra" text="Facturas compra" onAction="#onFacturasCompra" styleClass="sidebar-button"/>

            <Label text="PRODUCCION" styleClass="nav-section"/>
            <Button fx:id="btnRecetas" text="Recetas" onAction="#onRecetas" styleClass="sidebar-button"/>
            <Button fx:id="btnOrdenesProduccion" text="Ordenes produccion" onAction="#onOrdenesProduccion" styleClass="sidebar-button"/>
            <Button fx:id="btnHorneadas" text="Horneadas" onAction="#onHorneadas" styleClass="sidebar-button"/>
            <Button fx:id="btnLotes" text="Lotes / Trazabilidad" onAction="#onLotes" styleClass="sidebar-button"/>
            <Button fx:id="btnAppcc" text="Controles APPCC" onAction="#onAppcc" styleClass="sidebar-button"/>

            <Label text="REPARTO" styleClass="nav-section"/>
            <Button fx:id="btnVehiculos" text="Vehiculos" onAction="#onVehiculos" styleClass="sidebar-button"/>
            <Button fx:id="btnRutas" text="Rutas" onAction="#onRutas" styleClass="sidebar-button"/>
            <Button fx:id="btnHojasRuta" text="Hojas de ruta" onAction="#onHojasRuta" styleClass="sidebar-button"/>
            <Button fx:id="btnDevoluciones" text="Devoluciones" onAction="#onDevoluciones" styleClass="sidebar-button"/>

            <Label text="CONTROL" styleClass="nav-section"/>
            <Button fx:id="btnAsientos" text="Contabilidad" onAction="#onAsientos" styleClass="sidebar-button"/>
            <Button fx:id="btnPlanContable" text="Plan Contable" onAction="#onPlanContable" styleClass="sidebar-button"/>
            <Button fx:id="btnModelo347" text="Modelo 347" onAction="#onModelo347" styleClass="sidebar-button"/>
            <Button fx:id="btnBanco" text="Banco" onAction="#onMovimientosBanco" styleClass="sidebar-button"/>
            <Button fx:id="btnVerifactu" text="VeriFactu" onAction="#onVerifactu" styleClass="sidebar-button"/>
            <Button fx:id="btnBackups" text="Backups" onAction="#onBackups" styleClass="sidebar-button"/>

            <Region VBox.vgrow="ALWAYS" minHeight="10"/>
            <Separator/>
            <Button fx:id="btnUsuarios" text="Usuarios" onAction="#onUsuarios" styleClass="sidebar-button"/>
            <Button fx:id="btnAuditoria" text="Auditoria" onAction="#onAuditoria" styleClass="sidebar-button"/>
            <Button fx:id="btnConfiguracion" text="Configuracion" onAction="#onConfiguracion" styleClass="sidebar-button"/>
            </VBox>
        </ScrollPane>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
            <Label text="ERP Tahona" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnActualizarApp" text="Actualizar" onAction="#onActualizarApp" styleClass="button-primary" visible="false" managed="false"/>
            <Label fx:id="lblUsuario" text="Usuario" styleClass="muted"/>
            <Button text="Salir" onAction="#onCerrarSesion" styleClass="button"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-surface"/>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="status-bar">
            <Label text="ERP Tahona 2026" styleClass="status-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblEstado" text="Sistema operativo" styleClass="badge badge-success"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="lblFecha" text="2026-01-07" styleClass="status-label"/>
            <Label fx:id="lblHora" text="00:00:00" styleClass="status-label"/>
        </HBox>
    </bottom>

</BorderPane>
