<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.ui.MainPanelController"
            stylesheets="@/styles/simple-theme.css"
            styleClass="app-shell">

    <left>
        <VBox prefWidth="238" spacing="2" styleClass="sidebar">
            <VBox spacing="2" style="-fx-padding: 2 10 14 10;">
                <Label text="Tahona" styleClass="brand-title"/>
                <Label text="ERP de obrador y tienda" styleClass="brand-subtitle"/>
            </VBox>

            <Label text="HOY" styleClass="nav-section"/>
            <Button text="Panel" onAction="#onDashboard" styleClass="sidebar-button"/>
            <Button text="Caja" onAction="#onCaja" styleClass="sidebar-button"/>

            <Label text="VENTAS" styleClass="nav-section"/>
            <Button text="Facturas" onAction="#onFacturas" styleClass="sidebar-button"/>
            <Button text="Albaranes" onAction="#onAlbaranes" styleClass="sidebar-button"/>
            <Button text="Pedidos venta" onAction="#onPedidosVenta" styleClass="sidebar-button"/>
            <Button text="Presupuestos" onAction="#onPresupuestos" styleClass="sidebar-button"/>
            <Button text="Clientes" onAction="#onClientes" styleClass="sidebar-button"/>

            <Label text="OPERACION" styleClass="nav-section"/>
            <Button text="Articulos" onAction="#onArticulos" styleClass="sidebar-button"/>
            <Button text="Almacenes" onAction="#onAlmacenes" styleClass="sidebar-button"/>
            <Button text="Proveedores" onAction="#onProveedores" styleClass="sidebar-button"/>
            <Button text="Pedidos compra" onAction="#onPedidosCompra" styleClass="sidebar-button"/>
            <Button text="Facturas compra" onAction="#onFacturasCompra" styleClass="sidebar-button"/>

            <Label text="CONTROL" styleClass="nav-section"/>
            <Button fx:id="btnAsientos" text="Contabilidad" onAction="#onAsientos" styleClass="sidebar-button"/>
            <Button fx:id="btnModelo347" text="Modelo 347" onAction="#onModelo347" styleClass="sidebar-button"/>
            <Button text="Banco" onAction="#onMovimientosBanco" styleClass="sidebar-button"/>
            <Button text="VeriFactu" onAction="#onVerifactu" styleClass="sidebar-button"/>
            <Button fx:id="btnBackups" text="Backups" onAction="#onBackups" styleClass="sidebar-button"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator/>
            <Button fx:id="btnUsuarios" text="Usuarios" onAction="#onUsuarios" styleClass="sidebar-button"/>
            <Button fx:id="btnAuditoria" text="Auditoria" onAction="#onAuditoria" styleClass="sidebar-button"/>
            <Button text="Configuracion" onAction="#onConfiguracion" styleClass="sidebar-button"/>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
            <Label text="ERP Tahona" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnActualizarApp" text="Actualizar" onAction="#onActualizarApp" styleClass="button-primary" visible="false" managed="false"/>
            <Label fx:id="lblUsuario" text="Usuario" styleClass="muted"/>
            <Button text="Salir" onAction="#onCerrarSesion" styleClass="button"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-surface"/>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="status-bar">
            <Label text="ERP Tahona 2026" styleClass="status-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblEstado" text="Sistema operativo" styleClass="badge badge-success"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="lblFecha" text="2026-01-07" styleClass="status-label"/>
            <Label fx:id="lblHora" text="00:00:00" styleClass="status-label"/>
        </HBox>
    </bottom>

</BorderPane>
