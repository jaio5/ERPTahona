<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="alicanteweb.erp.controller.LoginController"
           style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <!-- Contenedor Principal de Login -->
    <VBox alignment="CENTER" maxWidth="460" spacing="24" 
          style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 48 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 30, 0, 0, 10);">
        <!-- Logo y Título -->
        <VBox alignment="CENTER" spacing="12">
            <Label text="🍞" style="-fx-font-size: 64;"/>
            <Label text="ERP Tahona" style="-fx-font-size: 32; -fx-font-weight: 700; -fx-text-fill: #1f2937;"/>
            <Label text="Sistema de Gestión Empresarial" style="-fx-font-size: 14; -fx-text-fill: #6b7280;"/>
        </VBox>
        <!-- Separador -->
        <Separator style="-fx-padding: 8 0;"/>
        <!-- Mensaje de Error -->
        <HBox fx:id="errorContainer" visible="false" managed="false"
              spacing="12" alignment="CENTER_LEFT"
              style="-fx-background-color: #fee2e2; -fx-background-radius: 8; -fx-padding: 12 16; -fx-border-color: #fecaca; -fx-border-radius: 8; -fx-border-width: 1;">
            <Label text="⚠️" style="-fx-font-size: 18;"/>
            <Label fx:id="errorLabel" text="Error en las credenciales"
                   style="-fx-text-fill: #dc2626; -fx-font-weight: 600; -fx-font-size: 14;"/>
        </HBox>
        <!-- Formulario de Login -->
        <VBox spacing="20" style="-fx-padding: 0;">
            <!-- Campo Usuario -->
            <VBox spacing="8">
                <Label text="Usuario" style="-fx-font-weight: 600; -fx-text-fill: #374151; -fx-font-size: 14;"/>
                <TextField fx:id="usernameField"
                          promptText="Ingrese su usuario"
                          style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14 16; -fx-font-size: 14; -fx-border-width: 2;"
                          onKeyPressed="#onKeyPressed"/>
            </VBox>
            <!-- Campo Contraseña -->
            <VBox spacing="8">
                <Label text="Contraseña" style="-fx-font-weight: 600; -fx-text-fill: #374151; -fx-font-size: 14;"/>
                <PasswordField fx:id="passwordField"
                              promptText="Ingrese su contraseña"
                              style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14 16; -fx-font-size: 14; -fx-border-width: 2;"
                              onKeyPressed="#onKeyPressed"/>
            </VBox>
            <!-- Botón de Login -->
            <Button fx:id="loginButton" text="Iniciar Sesión"
                    onAction="#handleLogin"
                    defaultButton="true"
                    maxWidth="Infinity"
                    style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: 700; -fx-padding: 16 0; -fx-background-radius: 10; -fx-cursor: hand;">
                <VBox.margin>
                    <Insets top="8"/>
                </VBox.margin>
            </Button>
        </VBox>
        <!-- Footer -->
        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 16 0 0 0;">
            <Separator style="-fx-padding: 0 0 8 0;"/>
            <Label text="© 2026 Panadería Tahona"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 12;"/>
            <Label text="Versión 1.0.0"
                   style="-fx-text-fill: #d1d5db; -fx-font-size: 11;"/>
        </VBox>
    </VBox>
</StackPane>
