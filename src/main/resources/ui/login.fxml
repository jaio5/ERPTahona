<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="alicanteweb.erp.controller.LoginController" 
      alignment="CENTER" spacing="20" 
      style="-fx-background-color: #2c3e50; -fx-padding: 40;">
    <Label text="ERP Panadería Tahona" 
           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
    <VBox alignment="CENTER" spacing="15" 
          style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10;" 
          maxWidth="400">
        <Label text="Iniciar Sesión" 
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <TextField fx:id="usernameField" 
                   promptText="Usuario"
                   style="-fx-min-width: 300px; -fx-pref-height: 35px;"/>
        <PasswordField fx:id="passwordField" 
                       promptText="Contraseña"
                       style="-fx-min-width: 300px; -fx-pref-height: 35px;"/>
        <CheckBox fx:id="rememberMeCheckbox"
                  text="Recordar contraseña"/>
        <Label fx:id="errorLabel" 
               style="-fx-text-fill: red; -fx-font-size: 12px;" 
               visible="false"
               wrapText="true"
               maxWidth="300"/>
        <Button fx:id="loginButton" 
                text="Iniciar Sesión" 
                onAction="#handleLogin" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-min-width: 300px; -fx-pref-height: 40px; -fx-font-size: 14px; -fx-cursor: hand;"
                defaultButton="true"/>
    </VBox>
</VBox>