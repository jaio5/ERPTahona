<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="alicanteweb.erp.controller.LoginController"
           stylesheets="@/styles/simple-theme.css"
           styleClass="login-background">

    <VBox alignment="CENTER_LEFT" maxWidth="420" spacing="22" styleClass="login-card">
        <VBox spacing="4">
            <Label text="Tahona" styleClass="login-title"/>
            <Label text="Gestion de obrador, tienda y facturacion" styleClass="login-subtitle"/>
        </VBox>

        <HBox fx:id="errorContainer" visible="false" managed="false"
              spacing="10" alignment="CENTER_LEFT" styleClass="login-error">
            <Label text="Aviso" style="-fx-text-fill: #b42318; -fx-font-weight: 700;"/>
            <Label fx:id="errorLabel" text="Error en las credenciales"
                   style="-fx-text-fill: #b42318; -fx-font-weight: 600;"/>
        </HBox>

        <VBox spacing="14">
            <VBox spacing="6">
                <Label text="Usuario" styleClass="stat-label"/>
                <TextField fx:id="usernameField"
                           promptText="Usuario"
                           onKeyPressed="#onKeyPressed"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Contrasena" styleClass="stat-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="Contrasena"
                               onKeyPressed="#onKeyPressed"/>
            </VBox>

            <Button fx:id="loginButton" text="Entrar"
                    onAction="#handleLogin"
                    defaultButton="true"
                    maxWidth="Infinity"
                    styleClass="button-primary">
                <VBox.margin>
                    <Insets top="8"/>
                </VBox.margin>
            </Button>
        </VBox>

        <Separator/>
        <Label text="ERP Tahona 2026" styleClass="muted"/>
    </VBox>
</StackPane>
