<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.AlbaranesVentaController"
            prefHeight="800.0" prefWidth="1400.0"
            stylesheets="/css/styles.css">

    <!-- Header -->
    <top>
        <VBox styleClass="header">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📦" style="-fx-font-size: 24px;"/>
                    <Label text="Gestión de Albaranes de Venta" styleClass="header-title"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVolver" text="← Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center - Split View -->
    <center>
        <SplitPane dividerPositions="0.6">
            <!-- Left: Table and Filters -->
            <VBox spacing="15" style="-fx-background-color: white;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <!-- Search and Filters -->
                <VBox spacing="15" styleClass="filters-panel">
                    <Label text="🔎 Búsqueda y Filtros" styleClass="subsection-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Buscar:" style="-fx-min-width: 80; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtSearch" promptText="Número o cliente..."
                                   HBox.hgrow="ALWAYS" styleClass="search-field"/>
                        <Button fx:id="btnSearch" text="🔎 Buscar" styleClass="btn-primary"/>
                        <Button text="⟳ Limpiar" onAction="#handleSearch" styleClass="btn-secondary"/>
                    </HBox>
                    <GridPane hgap="15" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="80" prefWidth="80"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
                            <ColumnConstraints minWidth="80" prefWidth="80"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
                        </columnConstraints>
                        <Label text="Fecha desde:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                               style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="dpFechaInicio" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                    maxWidth="Infinity"/>
                        <Label text="Fecha hasta:" GridPane.columnIndex="2" GridPane.rowIndex="0"
                               style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="dpFechaFin" GridPane.columnIndex="3" GridPane.rowIndex="0"
                                    maxWidth="Infinity"/>
                        <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                               style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="cboEstado" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                  maxWidth="Infinity" promptText="Todos los estados"/>
                        <Button fx:id="btnApplyFilters" text="Aplicar Filtros"
                                styleClass="btn-success" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>

                <!-- Table -->
                <TableView fx:id="tableAlbaranes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNumero" text="Número" prefWidth="100"/>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200"/>
                        <TableColumn fx:id="colAlmacen" text="Almacén" prefWidth="120"/>
                        <TableColumn fx:id="colTotal" text="Total" prefWidth="100"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right: Form -->
            <VBox spacing="15" style="-fx-background-color: #f8f9fa;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Datos del Albarán" styleClass="section-title">
                        <font><Font name="System Bold" size="16"/></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <!-- Formulario de albarán -->
                <VBox spacing="12">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Número:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtNumero" promptText="Número de albarán"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Fecha:" style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="dpFecha" promptText="Fecha"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Cliente:" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="cboCliente" promptText="Selecciona cliente"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Almacén:" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="cboAlmacen" promptText="Selecciona almacén"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Total:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtTotal" promptText="Total"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Observaciones:" style="-fx-font-weight: bold;"/>
                        <TextArea fx:id="txtObservaciones" promptText="Observaciones" prefRowCount="2"/>
                    </HBox>
                </VBox>
                <!-- Botonera principal -->
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="main-actions">
                    <Button fx:id="btnNuevo" text="➕ Nuevo" styleClass="btn-primary" onAction="#handleNuevo"/>
                    <Button fx:id="btnGuardar" text="💾 Guardar" styleClass="btn-success" onAction="#handleGuardar"/>
                    <Button fx:id="btnEliminar" text="🗑 Eliminar" styleClass="btn-danger" onAction="#handleEliminar"/>
                    <Button fx:id="btnVerLineas" text="📄 Ver Líneas" styleClass="btn-secondary" onAction="#handleVerLineas"/>
                    <Button text="🖨 Imprimir" onAction="#handleImprimirAlbaran" styleClass="btn-secondary"/>
                    <Button text="👁 Previsualizar" onAction="#handlePrevisualizarAlbaran" styleClass="btn-secondary"/>
                </HBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>