<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  MODERN & RESPONSIVE LAYOUT
  - Root: AnchorPane for a flexible, scalable UI container.
  - Structure: VBox manages the primary layout (header + content).
  - Content: SplitPane for the responsive master-detail view.
  - Filters (Left): A GridPane is used for a structured and aligned filter layout.
  - Form (Right): The main data form is rebuilt with a GridPane for a clean, responsive, and aligned user interface.
  - Styling: All inline styles removed. Styling is managed externally via '''styles.css'''.
-->
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.AlbaranesVentaController"
            styleClass="page-view"
            stylesheets="@/css/styles.css">
    <VBox AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
        <!-- Header -->
        <VBox styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📦" styleClass="header-icon"/>
                    <Label text="Gestión de Albaranes de Venta" styleClass="header-title"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVolver" text="← Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
            </HBox>
        </VBox>

        <!-- Main Content -->
        <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS" styleClass="page-content">
            <!-- Left Panel: Table and Filters -->
            <VBox spacing="15" styleClass="card">
                <VBox spacing="15" styleClass="filters-panel">
                    <Label text="🔎 Búsqueda y Filtros" styleClass="subsection-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Buscar:" styleClass="form-label"/>
                        <TextField fx:id="txtSearch" promptText="Número o cliente..." HBox.hgrow="ALWAYS" styleClass="search-field"/>
                        <Button fx:id="btnSearch" text="🔎 Buscar" styleClass="btn-primary"/>
                        <Button text="⟳ Limpiar" onAction="#handleSearch" styleClass="btn-secondary"/>
                    </HBox>
                    <GridPane hgap="15" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="80"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="80"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Fecha desde:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <DatePicker fx:id="dpFechaInicio" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Fecha hasta:" styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <DatePicker fx:id="dpFechaFin" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        <Label text="Estado:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="cboEstado" promptText="Todos los estados" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Button fx:id="btnApplyFilters" text="Aplicar Filtros" styleClass="btn-success" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>

                <TableView fx:id="tableAlbaranes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNumero" text="Número" prefWidth="100"/>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200"/>
                        <TableColumn fx:id="colAlmacen" text="Almacén" prefWidth="120"/>
                        <TableColumn fx:id="colTotal" text="Total" prefWidth="100"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right Panel: Form -->
            <AnchorPane>
                <VBox spacing="20" styleClass="card" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
                    <Label text="📝 Datos del Albarán" styleClass="section-title"/>

                    <GridPane hgap="10" vgap="15" VBox.vgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Número:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtNumero" promptText="Número de albarán" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Fecha:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <DatePicker fx:id="dpFecha" promptText="Fecha" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Cliente:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cboCliente" promptText="Selecciona cliente" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Almacén:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cboAlmacen" promptText="Selecciona almacén" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="Total:" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtTotal" promptText="Total" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        <Label text="Obs.:" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextArea fx:id="txtObservaciones" promptText="Observaciones" prefRowCount="3" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        <rowConstraints>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        </rowConstraints>
                    </GridPane>

                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="main-actions" wrapText="true">
                        <Button fx:id="btnNuevo" text="➕ Nuevo" styleClass="btn-primary" onAction="#handleNuevo"/>
                        <Button fx:id="btnGuardar" text="💾 Guardar" styleClass="btn-success" onAction="#handleGuardar"/>
                        <Button fx:id="btnEliminar" text="🗑 Eliminar" styleClass="btn-danger" onAction="#handleEliminar"/>
                        <Button fx:id="btnVerLineas" text="📄 Ver Líneas" styleClass="btn-secondary" onAction="#handleVerLineas"/>
                        <Button text="🖨 Imprimir" onAction="#handleImprimirAlbaran" styleClass="btn-secondary"/>
                        <Button text="👁 Previsualizar" onAction="#handlePrevisualizarAlbaran" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>
            </AnchorPane>
        </SplitPane>
    </VBox>
</AnchorPane>
