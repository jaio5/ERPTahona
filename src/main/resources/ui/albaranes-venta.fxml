<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alicanteweb.erp.controller.AlbaranesVentaController"
            prefHeight="800.0" prefWidth="1400.0"
            stylesheets="/css/styles.css">

    <!-- Header -->
    <top>
        <VBox styleClass="header">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Gestión de Albaranes de Venta" styleClass="header-title">
                    <font><Font name="System Bold" size="22"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVolver" text="← Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center - Split View -->
    <center>
        <SplitPane dividerPositions="0.6">
            <!-- Left: Table and Filters -->
            <VBox spacing="10">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <!-- Search and Filters -->
                <VBox spacing="8" styleClass="filters-panel">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>

                    <!-- Search Bar -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Buscar:">
                            <font><Font name="System Bold" size="12"/></font>
                        </Label>
                        <TextField fx:id="txtSearch" promptText="Número o cliente..."
                                   HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnSearch" text="Buscar" styleClass="btn-primary"/>
                    </HBox>

                    <!-- Date Filters -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Desde:">
                            <font><Font name="System Bold" size="12"/></font>
                        </Label>
                        <DatePicker fx:id="dpFechaInicio" prefWidth="150"/>

                        <Label text="Hasta:">
                            <font><Font name="System Bold" size="12"/></font>
                        </Label>
                        <DatePicker fx:id="dpFechaFin" prefWidth="150"/>

                        <Label text="Estado:">
                            <font><Font name="System Bold" size="12"/></font>
                        </Label>
                        <ComboBox fx:id="cboEstado" prefWidth="120"/>

                        <Button fx:id="btnApplyFilters" text="Aplicar Filtros"
                                styleClass="btn-success"/>
                    </HBox>
                </VBox>

                <!-- Table -->
                <TableView fx:id="tableAlbaranes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNumero" text="Número" prefWidth="100"/>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200"/>
                        <TableColumn fx:id="colAlmacen" text="Almacén" prefWidth="120"/>
                        <TableColumn fx:id="colTotal" text="Total" prefWidth="100"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right: Form -->
            <VBox spacing="15">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <!-- Form Title -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Datos del Albarán" styleClass="section-title">
                        <font><Font name="System Bold" size="16"/></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblLineas" text="0 línea(s)" styleClass="info-badge">
                        <font><Font size="12"/></font>
                    </Label>
                </HBox>

                <Separator/>

                <!-- Form Fields -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <VBox spacing="15">
                        <padding>
                            <Insets top="5" right="5" bottom="5" left="5"/>
                        </padding>

                        <GridPane hgap="10" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <!-- Número -->
                            <Label text="Número:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <TextField fx:id="txtNumero" promptText="ALB-2025-0001"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <!-- Fecha -->
                            <Label text="Fecha:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <DatePicker fx:id="dpFecha"
                                        GridPane.columnIndex="1" GridPane.rowIndex="1"
                                        maxWidth="Infinity"/>

                            <!-- Cliente -->
                            <Label text="Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <ComboBox fx:id="cboCliente"
                                      GridPane.columnIndex="1" GridPane.rowIndex="2"
                                      maxWidth="Infinity"/>

                            <!-- Almacén -->
                            <Label text="Almacén:" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <ComboBox fx:id="cboAlmacen"
                                      GridPane.columnIndex="1" GridPane.rowIndex="3"
                                      maxWidth="Infinity"/>

                            <!-- Total -->
                            <Label text="Total:" GridPane.columnIndex="0" GridPane.rowIndex="4">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <TextField fx:id="txtTotal" editable="false"
                                       styleClass="total-field"
                                       GridPane.columnIndex="1" GridPane.rowIndex="4">
                                <font><Font name="System Bold" size="14"/></font>
                            </TextField>

                            <!-- Observaciones -->
                            <Label text="Observaciones:"
                                   GridPane.columnIndex="0" GridPane.rowIndex="5"
                                   GridPane.valignment="TOP">
                                <font><Font name="System Bold" size="12"/></font>
                            </Label>
                            <TextArea fx:id="txtObservaciones" prefRowCount="6"
                                      wrapText="true"
                                      GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                        </GridPane>
                    </VBox>
                </ScrollPane>

                <Separator/>

                <!-- Action Buttons -->
                <VBox spacing="10">
                    <!-- Primary Actions -->
                    <HBox spacing="10" alignment="CENTER">
                        <Button fx:id="btnNuevo" text="Nuevo" styleClass="btn-success" prefWidth="120">
                            <font><Font size="12"/></font>
                        </Button>
                        <Button fx:id="btnGuardar" text="Guardar" styleClass="btn-primary" prefWidth="120">
                            <font><Font size="12"/></font>
                        </Button>
                        <Button fx:id="btnEliminar" text="Eliminar" styleClass="btn-danger" prefWidth="120">
                            <font><Font size="12"/></font>
                        </Button>
                    </HBox>

                    <!-- Secondary Actions -->
                    <HBox spacing="10" alignment="CENTER">
                        <Button fx:id="btnVerLineas" text="Ver/Editar Líneas"
                                styleClass="btn-info" prefWidth="250">
                            <font><Font size="12"/></font>
                        </Button>
                    </HBox>

                    <!-- New Buttons -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Nuevo albarán" onAction="#handleNuevoAlbaran" styleClass="btn-primary"/>
                        <Button text="Imprimir" onAction="#handleImprimirAlbaran" styleClass="btn-primary"/>
                        <Button text="Previsualizar" onAction="#handlePrevisualizarAlbaran" styleClass="btn-info"/>
                    </HBox>
                </VBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>