<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.DevolucionController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="DEVOLUCIONES" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refrescar" onAction="#onRefresh" styleClass="button"/>
        <Button text="+ Nueva Devolución" onAction="#onNuevo" styleClass="button-success"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="Buscar devolución..." HBox.hgrow="ALWAYS" style="-fx-min-height: 40px;"/>
        <Button text="Buscar" onAction="#onBuscar" styleClass="button-primary"/>
    </HBox>

    <TableView fx:id="tableDevoluciones" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="colNumero" text="Número" minWidth="80" maxWidth="110"/>
            <TableColumn fx:id="colFecha" text="Fecha" minWidth="80" maxWidth="110"/>
            <TableColumn fx:id="colEstado" text="Estado" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="colImporte" text="Importe" minWidth="80" maxWidth="110"/>
        </columns>
    </TableView>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Aceptar Devolución" onAction="#onAceptarDevolucion" styleClass="button-success"/>
        <Button text="Editar" onAction="#onEditar" styleClass="button-primary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 devoluciones" style="-fx-text-fill: #6c757d;"/>
    </HBox>
</VBox>
