<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.ArticuloController"
      stylesheets="@/styles/simple-theme.css"
      styleClass="screen"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox styleClass="screen-header">
        <VBox spacing="2">
            <Label text="Articulos" styleClass="title"/>
            <Label text="Catalogo, precios e inventario del obrador." styleClass="subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refrescar" onAction="#onRefresh" styleClass="button"/>
        <Button text="Nuevo articulo" onAction="#onNuevo" styleClass="button-success"/>
    </HBox>

    <HBox styleClass="screen-toolbar">
        <TextField fx:id="txtBuscar" promptText="Buscar articulo..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="cmbCategoria" promptText="Categoria" minWidth="120" maxWidth="160"/>
        <ComboBox fx:id="cmbActivo" promptText="Estado" minWidth="100" maxWidth="140"/>
        <Button text="Buscar" onAction="#onBuscarArticulo" styleClass="button-primary"/>
    </HBox>

    <TableView fx:id="tableArticulos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" text="Codigo" minWidth="70" maxWidth="100"/>
            <TableColumn fx:id="colNombre" text="Nombre" minWidth="150"/>
            <TableColumn fx:id="colPrecio" text="PVP" minWidth="70" maxWidth="100"/>
            <TableColumn fx:id="colIVA" text="IVA %" minWidth="50" maxWidth="80"/>
            <TableColumn fx:id="colStock" text="Stock" minWidth="60" maxWidth="80"/>
            <TableColumn fx:id="colActivo" text="Activo" minWidth="50" maxWidth="70"/>
        </columns>
    </TableView>

    <HBox styleClass="screen-footer">
        <Button text="Ver" onAction="#onVerArticulo" styleClass="button"/>
        <Button text="Editar" onAction="#onEditar" styleClass="button-primary"/>
        <Button text="Dar de baja" onAction="#onDarBajaArticulo" styleClass="button-danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 articulos" styleClass="muted"/>
    </HBox>

</VBox>
