<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.AlbaranFormController"
      styleClass="main-container" spacing="15">

    <stylesheets>
        <String fx:value="@/styles/unified-styles.css"/>
    </stylesheets>

    <Label text="📦 FORMULARIO DE ALBARÁN" styleClass="title-panel"/>

    <ScrollPane fitToWidth="true">
        <VBox spacing="15" style="-fx-padding: 15;">

            <!-- DATOS DE ALBARÁN -->
            <TitledPane text="📋 Datos de Albarán" collapsible="false" style="-fx-font-weight: bold;">
                <GridPane hgap="20" vgap="15" style="-fx-padding: 15;">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <Label text="Número Albarán:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtNumero" promptText="Auto-generado" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-min-height: 35;"/>

                    <Label text="Fecha:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    <DatePicker fx:id="dpFecha" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-min-height: 35;"/>

                    <Label text="Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="cbCliente" promptText="Selecciona cliente..." GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-min-height: 35;"/>

                    <Label text="Procedencia:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="cbProcedencia" promptText="Pedido/Presupuesto..." GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-min-height: 35;"/>
                </GridPane>
            </TitledPane>

            <!-- LÍNEAS DE ALBARÁN -->
            <TitledPane text="📦 Líneas de Albarán" collapsible="false" style="-fx-font-weight: bold;">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <TableView fx:id="tableLineas" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="colArticulo" text="Artículo" prefWidth="150"/>
                            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80"/>
                            <TableColumn fx:id="colUnidad" text="Unidad" prefWidth="80"/>
                            <TableColumn fx:id="colLote" text="Lote/Serie" prefWidth="100"/>
                        </columns>
                    </TableView>
                    <HBox spacing="10">
                        <Button text="➕ Agregar Línea" styleClass="button-action" onAction="#onAgregarLinea" style="-fx-padding: 8 16;"/>
                        <Button text="🗑️ Eliminar Línea" styleClass="button-danger" onAction="#onEliminarLinea" style="-fx-padding: 8 16;"/>
                    </HBox>
                </VBox>
            </TitledPane>

            <!-- DATOS DE ENTREGA -->
            <TitledPane text="📍 Datos de Entrega" collapsible="false" style="-fx-font-weight: bold;">
                <GridPane hgap="20" vgap="15" style="-fx-padding: 15;">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="100"/>
                    </columnConstraints>

                    <Label text="Dirección de Entrega:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="txtDireccionEntrega" promptText="Dirección de entrega..." GridPane.columnIndex="0" GridPane.rowIndex="1" prefRowCount="3" style="-fx-min-height: 60;"/>

                    <Label text="Observaciones:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="txtObservaciones" promptText="Instrucciones especiales..." GridPane.columnIndex="0" GridPane.rowIndex="3" prefRowCount="3" style="-fx-min-height: 60;"/>
                </GridPane>
            </TitledPane>
        </VBox>
    </ScrollPane>

    <Separator/>

    <!-- BOTONES -->
    <HBox spacing="15" style="-fx-alignment: center-right; -fx-padding: 15;">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="💾 Guardar" styleClass="button-primary" onAction="#onGuardar" style="-fx-padding: 12 30; -fx-font-size: 13;"/>
        <Button text="🧾 Convertir a Factura" styleClass="button-success" onAction="#onConvertirFactura" style="-fx-padding: 12 30; -fx-font-size: 13;"/>
        <Button text="❌ Cancelar" styleClass="button-neutral" onAction="#onCancelar" style="-fx-padding: 12 30; -fx-font-size: 13;"/>
    </HBox>
</VBox>
