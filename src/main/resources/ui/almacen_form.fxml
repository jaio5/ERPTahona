<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.AlmacenFormController"
      styleClass="main-container" spacing="15">

    <Label text="🏭 FORMULARIO DE ALMACÉN" styleClass="title-panel"/>

    <ScrollPane fitToWidth="true">
        <VBox spacing="15" style="-fx-padding: 15;">

            <!-- DATOS BÁSICOS -->
            <TitledPane text="📋 Datos Básicos" collapsible="false" style="-fx-font-weight: bold;">
                <GridPane hgap="20" vgap="15" style="-fx-padding: 15;">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <Label text="Código Almacén:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtCodigo" promptText="ej. ALM01" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-min-height: 35;"/>

                    <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtNombre" promptText="ej. Almacén Principal" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-min-height: 35;"/>

                    <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="txtDescripcion" promptText="Descripción del almacén..." GridPane.columnIndex="1" GridPane.rowIndex="2" prefRowCount="3" style="-fx-min-height: 60;"/>
                </GridPane>
            </TitledPane>

            <!-- DATOS DE CAPACIDAD -->
            <TitledPane text="📦 Capacidad" collapsible="false" style="-fx-font-weight: bold;">
                <GridPane hgap="20" vgap="15" style="-fx-padding: 15;">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <Label text="Capacidad Total (m³):" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtCapacidad" promptText="ej. 500" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-min-height: 35;"/>

                    <Label text="Espacio Disponible (m³):" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtDisponible" promptText="ej. 250" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-min-height: 35;"/>
                </GridPane>
            </TitledPane>

            <!-- DATOS DE UBICACIÓN -->
            <TitledPane text="📍 Ubicación" collapsible="false" style="-fx-font-weight: bold;">
                <GridPane hgap="20" vgap="15" style="-fx-padding: 15;">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <Label text="Localidad:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtLocalidad" promptText="ej. Alicante" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-min-height: 35;"/>

                    <Label text="Responsable:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtResponsable" promptText="ej. Juan García" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-min-height: 35;"/>
                </GridPane>
            </TitledPane>

            <!-- ESTADO -->
            <HBox spacing="20" style="-fx-padding: 10;">
                <CheckBox fx:id="chkActivo" text="✓ Almacén Activo" selected="true" style="-fx-font-size: 13;"/>
            </HBox>
        </VBox>
    </ScrollPane>

    <Separator/>

    <!-- BOTONES -->
    <HBox spacing="15" style="-fx-alignment: center-right; -fx-padding: 15;">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnGuardar" text="💾 Guardar" styleClass="button-primary" onAction="#onGuardar" style="-fx-padding: 12 30; -fx-font-size: 13;"/>
        <Button fx:id="btnCancelar" text="❌ Cancelar" styleClass="button-neutral" onAction="#onCancelar" style="-fx-padding: 12 30; -fx-font-size: 13;"/>
    </HBox>
</VBox>
