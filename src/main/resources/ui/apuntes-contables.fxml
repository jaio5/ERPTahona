<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="alicanteweb.erp.controller.ApunteContableController">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Apuntes contables" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Volver" onAction="#handleVolver"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tableApuntes">
            <columns>
                <TableColumn fx:id="colCuenta" text="Cuenta"/>
                <TableColumn fx:id="colDebe" text="Debe"/>
                <TableColumn fx:id="colHaber" text="Haber"/>
            </columns>
        </TableView>
    </center>
</BorderPane>

