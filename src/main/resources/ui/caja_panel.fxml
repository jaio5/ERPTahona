<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.CajaController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="💰 Caja" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄" onAction="#onRefresh" styleClass="button" style="-fx-font-size: 16;"/>
        <Button text="+ Nuevo Movimiento" onAction="#onNuevo" styleClass="button-success"/>
    </HBox>

    <HBox spacing="12">
        <TextField fx:id="txtBuscar" promptText="🔍 Buscar movimiento..." HBox.hgrow="ALWAYS" style="-fx-min-height: 40px;"/>
        <DatePicker fx:id="dpFechaDesde" promptText="Desde" prefWidth="130"/>
        <DatePicker fx:id="dpFechaHasta" promptText="Hasta" prefWidth="130"/>
        <Button text="Buscar" onAction="#onBuscar" styleClass="button-primary"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS">
        <TableView fx:id="tableMovimientos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                <TableColumn fx:id="colConcepto" text="Concepto" prefWidth="300"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
                <TableColumn fx:id="colImporte" text="Importe" prefWidth="120"/>
                <TableColumn fx:id="colSaldo" text="Saldo" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>

    <HBox spacing="12">
        <Button text="👁️ Ver" onAction="#onVer" styleClass="button"/>
        <Button text="🗑️ Eliminar" onAction="#onEliminar" styleClass="button-danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblSaldo" text="Saldo: 0.00 €" style="-fx-text-fill: #0d6efd; -fx-font-size: 16; -fx-font-weight: 600;"/>
    </HBox>

</VBox>

