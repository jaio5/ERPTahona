<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.CajaController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="CAJA" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER_RIGHT" spacing="4">
            <Label text="Saldo Actual" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
            <Label fx:id="lblSaldo" text="0.00 EUR" style="-fx-font-size: 24; -fx-font-weight: 700; -fx-text-fill: #198754;"/>
        </VBox>
    </HBox>

    <HBox spacing="16">
        <Button text="+ Ingreso" onAction="#onNuevo" styleClass="button-success" style="-fx-min-width: 120;"/>
        <Button text="- Gasto" onAction="#onNuevo" styleClass="button-danger" style="-fx-min-width: 120;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refrescar" onAction="#onRefresh" styleClass="button"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="Buscar movimiento..." HBox.hgrow="ALWAYS" style="-fx-min-height: 40px;"/>
        <ComboBox fx:id="cmbTipo" promptText="Tipo" minWidth="100" maxWidth="140"/>
        <DatePicker fx:id="dpFechaDesde" promptText="Desde"/>
        <DatePicker fx:id="dpFechaHasta" promptText="Hasta"/>
        <Button text="Buscar" onAction="#onBuscar" styleClass="button-primary"/>
    </HBox>

    <TableView fx:id="tableMovimientos" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="colTipo" text="Tipo" minWidth="70" maxWidth="90"/>
            <TableColumn fx:id="colConcepto" text="Concepto" minWidth="150"/>
            <TableColumn fx:id="colCategoria" text="Categoría" minWidth="100"/>
            <TableColumn fx:id="colImporte" text="Importe" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="colDocumento" text="Documento" minWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Ver" onAction="#onVer" styleClass="button"/>
        <Button text="Editar" onAction="#onEditar" styleClass="button-primary"/>
        <Button text="Eliminar" onAction="#onEliminar" styleClass="button-danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER_RIGHT" spacing="2">
            <Label fx:id="lblTotalIngresos" text="Ingresos: 0.00 EUR" style="-fx-text-fill: #198754;"/>
            <Label fx:id="lblTotalGastos" text="Gastos: 0.00 EUR" style="-fx-text-fill: #dc3545;"/>
        </VBox>
    </HBox>

</VBox>

