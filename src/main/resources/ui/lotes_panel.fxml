<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.LoteController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="LOTES / TRAZABILIDAD" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refrescar" onAction="#onRefresh" styleClass="button"/>
        <Button text="+ Nuevo Lote" onAction="#onNuevo" styleClass="button-success"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="Buscar lote..." HBox.hgrow="ALWAYS" style="-fx-min-height: 40px;"/>
        <Button text="Buscar" onAction="#onBuscar" styleClass="button-primary"/>
    </HBox>

    <TableView fx:id="tableLotes" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" minWidth="70" maxWidth="120"/>
            <TableColumn fx:id="colFechaProd" text="Fecha Prod." minWidth="90" maxWidth="120"/>
            <TableColumn fx:id="colFechaCad" text="Caducidad" minWidth="90" maxWidth="120"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" minWidth="70" maxWidth="90"/>
            <TableColumn fx:id="colEstado" text="Estado" minWidth="80" maxWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Ver Trazabilidad" onAction="#onVerTrazabilidad" styleClass="button-primary"/>
        <Button text="Editar" onAction="#onEditar" styleClass="button-primary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 lotes" style="-fx-text-fill: #6c757d;"/>
    </HBox>
</VBox>
