<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.PresupuestoController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="PRESUPUESTOS" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refrescar" onAction="#onRefresh" onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonExit" styleClass="button"/>
        <Button text="+ Nuevo Presupuesto" onAction="#onNuevo" onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonExit" styleClass="button-success"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="Buscar presupuesto..." HBox.hgrow="ALWAYS" style="-fx-min-height: 40px;"/>
        <ComboBox fx:id="cmbEstado" promptText="Estado" minWidth="100" maxWidth="140"/>
        <DatePicker fx:id="dpFechaDesde" promptText="Desde"/>
        <DatePicker fx:id="dpFechaHasta" promptText="Hasta"/>
        <Button text="Buscar" onAction="#onBuscar" onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonExit" styleClass="button-primary"/>
    </HBox>

    <TableView fx:id="pres_tablePresupuestos" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="pres_colNumero" text="Número" minWidth="80" maxWidth="120"/>
            <TableColumn fx:id="pres_colFecha" text="Fecha" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="pres_colCliente" text="Cliente" minWidth="150"/>
            <TableColumn fx:id="pres_colBaseImponible" text="Base" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="pres_colTotal" text="Total" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="pres_colValidez" text="Validez" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="pres_colEstado" text="Estado" minWidth="80" maxWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Ver" onAction="#onVer" onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonExit" styleClass="button"/>
        <Button text="Editar" onAction="#onEditar" onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonExit" styleClass="button-primary"/>
        <Button text="Aceptar" onAction="#onAceptar" onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonExit" styleClass="button-success"/>
        <Button text="Rechazar" onAction="#onRechazar" onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonExit" styleClass="button"/>
        <Button text="Eliminar" onAction="#onEliminar" onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonExit" styleClass="button-danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="pres_lblTotal" text="0 presupuestos" style="-fx-text-fill: #6c757d;"/>
    </HBox>

</VBox>

