<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.PresupuestoController"
      stylesheets="@/styles/simple-theme.css"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 32;">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="Presupuestos" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄" onAction="#onRefresh" styleClass="button" style="-fx-font-size: 16;"/>
        <Button text="+ Nuevo Presupuesto" onAction="#onNuevo" styleClass="button-success"/>
    </HBox>

    <HBox spacing="12">
        <TextField fx:id="txtBuscar" promptText="🔍 Buscar presupuesto..." HBox.hgrow="ALWAYS" style="-fx-min-height: 40px;"/>
        <ComboBox fx:id="cmbEstado" promptText="Estado" prefWidth="130"/>
        <Button text="Buscar" onAction="#onBuscar" styleClass="button-primary"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS">
        <TableView fx:id="tablePresupuestos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNumero" text="Número" prefWidth="120"/>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                <TableColumn fx:id="colCliente" text="Cliente" prefWidth="250"/>
                <TableColumn fx:id="colBaseImponible" text="Base" prefWidth="100"/>
                <TableColumn fx:id="colTotal" text="Total" prefWidth="120"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

    <HBox spacing="12">
        <Button text="👁️ Ver" onAction="#onVer" styleClass="button"/>
        <Button text="✏️ Editar" onAction="#onEditar" styleClass="button-primary"/>
        <Button text="✅ Aceptar" onAction="#onAceptar" styleClass="button-success"/>
        <Button text="❌ Rechazar" onAction="#onRechazar" styleClass="button-danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblEstado" text="0 presupuestos" style="-fx-text-fill: #6c757d;"/>
    </HBox>

</VBox>

