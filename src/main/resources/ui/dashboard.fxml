<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.ui.DashboardController"
      stylesheets="@/styles/simple-theme.css"
      spacing="24" style="-fx-background-color: #f8f9fa; -fx-padding: 32;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="Dashboard - Panel Principal" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refrescar" onAction="#onRefresh" styleClass="button" style="-fx-font-size: 14;"/>
    </HBox>

    <HBox spacing="20" alignment="CENTER" HBox.hgrow="ALWAYS">
        <VBox styleClass="dashboard-card" spacing="8" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <Label text="Ventas del Dia" style="-fx-font-size: 14; -fx-text-fill: #6c757d;"/>
            <Label fx:id="lblVentasDia" text="0.00 EUR" style="-fx-font-size: 28; -fx-font-weight: 700; -fx-text-fill: #0d6efd;"/>
            <Label fx:id="lblFacturasHoy" text="0 facturas" style="-fx-font-size: 12; -fx-text-fill: #6c757d;"/>
        </VBox>

        <VBox styleClass="dashboard-card" spacing="8" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <Label text="Ventas del Mes" style="-fx-font-size: 14; -fx-text-fill: #6c757d;"/>
            <Label fx:id="lblVentasMes" text="0.00 EUR" style="-fx-font-size: 28; -fx-font-weight: 700; -fx-text-fill: #198754;"/>
            <Label fx:id="lblFacturasMes" text="0 facturas" style="-fx-font-size: 12; -fx-text-fill: #6c757d;"/>
        </VBox>

        <VBox styleClass="dashboard-card" spacing="8" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <Label text="Clientes" style="-fx-font-size: 14; -fx-text-fill: #6c757d;"/>
            <Label fx:id="lblClientes" text="0" style="-fx-font-size: 28; -fx-font-weight: 700; -fx-text-fill: #6610f2;"/>
            <Label text="Total de clientes" style="-fx-font-size: 12; -fx-text-fill: #6c757d;"/>
        </VBox>

        <VBox styleClass="dashboard-card" spacing="8" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <Label text="Articulos" style="-fx-font-size: 14; -fx-text-fill: #6c757d;"/>
            <Label fx:id="lblArticulos" text="0" style="-fx-font-size: 28; -fx-font-weight: 700; -fx-text-fill: #fd7e14;"/>
            <Label text="Productos activos" style="-fx-font-size: 12; -fx-text-fill: #6c757d;"/>
        </VBox>
    </HBox>

    <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="Accesos Rapidos" style="-fx-font-size: 18; -fx-font-weight: 600;"/>

        <GridPane hgap="16" vgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
            </columnConstraints>

            <Button text="Nueva Factura" onAction="#onNuevaFactura" styleClass="button-success"
                    maxWidth="Infinity" style="-fx-min-height: 60; -fx-font-size: 13;"
                    GridPane.columnIndex="0" GridPane.rowIndex="0"/>

            <Button text="Nuevo Albarán" onAction="#onNuevoAlbaran" styleClass="button-primary"
                    maxWidth="Infinity" style="-fx-min-height: 60; -fx-font-size: 13;"
                    GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Button text="Nuevo Cliente" onAction="#onNuevoCliente" styleClass="button-primary"
                    maxWidth="Infinity" style="-fx-min-height: 60; -fx-font-size: 13;"
                    GridPane.columnIndex="2" GridPane.rowIndex="0"/>

            <Button text="Nuevo Artículo" onAction="#onNuevoArticulo" styleClass="button-primary"
                    maxWidth="Infinity" style="-fx-min-height: 60; -fx-font-size: 13;"
                    GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Button text="Proveedores" onAction="#onProveedores" styleClass="button"
                    maxWidth="Infinity" style="-fx-min-height: 60; -fx-font-size: 13;"
                    GridPane.columnIndex="0" GridPane.rowIndex="1"/>

            <Button text="Caja" onAction="#onCaja" styleClass="button"
                    maxWidth="Infinity" style="-fx-min-height: 60; -fx-font-size: 13;"
                    GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Button text="Contabilidad" onAction="#onContabilidad" styleClass="button"
                    maxWidth="Infinity" style="-fx-min-height: 60; -fx-font-size: 13;"
                    GridPane.columnIndex="2" GridPane.rowIndex="1"/>

            <Button text="Configuración" onAction="#onConfiguracion" styleClass="button"
                    maxWidth="Infinity" style="-fx-min-height: 60; -fx-font-size: 13;"
                    GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        </GridPane>
    </VBox>

    <VBox VBox.vgrow="ALWAYS" spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="Últimas Facturas" style="-fx-font-size: 18; -fx-font-weight: 600;"/>

        <TableView fx:id="tableUltimasFacturas" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
            <columns>
                <TableColumn fx:id="colNumero" text="Número" minWidth="80" maxWidth="120"/>
                <TableColumn fx:id="colFecha" text="Fecha" minWidth="80" maxWidth="100"/>
                <TableColumn fx:id="colCliente" text="Cliente" minWidth="150"/>
                <TableColumn fx:id="colTotal" text="Total" minWidth="80" maxWidth="120"/>
                <TableColumn fx:id="colEstado" text="Estado" minWidth="70" maxWidth="100"/>
            </columns>
        </TableView>
    </VBox>

</VBox>

