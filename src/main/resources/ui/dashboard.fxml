<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alicanteweb.erp.controller.ui.DashboardController"
      stylesheets="@/styles/simple-theme.css"
      spacing="18" style="-fx-padding: 24;"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Panel de trabajo" styleClass="title"/>
            <Label text="Lo importante del dia, sin ruido." styleClass="subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refrescar" onAction="#onRefresh" styleClass="button"/>
    </HBox>

    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
        </columnConstraints>

        <VBox styleClass="stat-card" spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Hoy" styleClass="stat-label"/>
            <Label fx:id="lblVentasDia" text="0.00 EUR" styleClass="stat-value"/>
            <Label fx:id="lblFacturasHoy" text="0 facturas" styleClass="muted"/>
        </VBox>

        <VBox styleClass="stat-card" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Mes" styleClass="stat-label"/>
            <Label fx:id="lblVentasMes" text="0.00 EUR" styleClass="stat-value"/>
            <Label fx:id="lblFacturasMes" text="0 facturas" styleClass="muted"/>
        </VBox>

        <VBox styleClass="stat-card" spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
            <Label text="Clientes" styleClass="stat-label"/>
            <Label fx:id="lblClientes" text="0" styleClass="stat-value"/>
            <Label text="Activos en la base" styleClass="muted"/>
        </VBox>

        <VBox styleClass="stat-card" spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="0">
            <Label text="Articulos" styleClass="stat-label"/>
            <Label fx:id="lblArticulos" text="0" styleClass="stat-value"/>
            <Label text="Catalogo operativo" styleClass="muted"/>
        </VBox>

        <!-- Segunda fila: KPIs de produccion y reparto -->
        <VBox styleClass="stat-card" spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Ordenes activas" styleClass="stat-label"/>
            <Label fx:id="lblOrdenesActivas" text="0" styleClass="stat-value"/>
            <Label text="Produccion en curso" styleClass="muted"/>
        </VBox>

        <VBox styleClass="stat-card" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Lotes por caducar" styleClass="stat-label"/>
            <Label fx:id="lblLotesCaducar" text="0" styleClass="stat-value"/>
            <Label text="Proximos 7 dias" styleClass="muted"/>
        </VBox>

        <VBox styleClass="stat-card" spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="1">
            <Label text="Rutas activas" styleClass="stat-label"/>
            <Label fx:id="lblEntregasPendientes" text="0" styleClass="stat-value"/>
            <Label text="Hojas en curso" styleClass="muted"/>
        </VBox>

        <VBox styleClass="stat-card" spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="1">
            <Label text="Recetas" styleClass="stat-label"/>
            <Label fx:id="lblRecetas" text="0" styleClass="stat-value"/>
            <Label text="Formulas activas" styleClass="muted"/>
        </VBox>
    </GridPane>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Nueva factura" onAction="#onNuevaFactura" styleClass="button-primary quick-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Nuevo albaran" onAction="#onNuevoAlbaran" styleClass="button quick-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Nuevo cliente" onAction="#onNuevoCliente" styleClass="button quick-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Nuevo articulo" onAction="#onNuevoArticulo" styleClass="button quick-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
        </columnConstraints>

        <VBox styleClass="card" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Atajos de venta" styleClass="section-title"/>
            <Button text="Facturas" onAction="#onNuevaFactura" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button text="Albaranes" onAction="#onNuevoAlbaran" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button text="Presupuestos" onAction="#onPresupuestos" styleClass="sidebar-button" maxWidth="Infinity"/>
        </VBox>

        <VBox styleClass="card" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Gestion diaria" styleClass="section-title"/>
            <Button text="Caja" onAction="#onCaja" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button text="Proveedores" onAction="#onProveedores" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button text="Articulos" onAction="#onNuevoArticulo" styleClass="sidebar-button" maxWidth="Infinity"/>
        </VBox>

        <VBox styleClass="card" spacing="10" GridPane.columnIndex="2" GridPane.rowIndex="0">
            <Label text="Control" styleClass="section-title"/>
            <Button text="Contabilidad" onAction="#onContabilidad" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button text="Configuracion" onAction="#onConfiguracion" styleClass="sidebar-button" maxWidth="Infinity"/>
        </VBox>

        <VBox styleClass="card" spacing="10" GridPane.columnIndex="3" GridPane.rowIndex="0">
            <Label text="Produccion y Reparto" styleClass="section-title"/>
            <Button text="Recetas" onAction="#onProduccion" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button text="Trazabilidad" onAction="#onTrazabilidad" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button text="Hojas de ruta" onAction="#onReparto" styleClass="sidebar-button" maxWidth="Infinity"/>
        </VBox>
    </GridPane>

    <VBox VBox.vgrow="ALWAYS" spacing="10" styleClass="card">
        <HBox alignment="CENTER_LEFT">
            <Label text="Ultimas facturas" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Seguimiento rapido" styleClass="muted"/>
        </HBox>
        <TableView fx:id="tableUltimasFacturas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNumero" text="Numero" minWidth="90" prefWidth="120"/>
                <TableColumn fx:id="colFecha" text="Fecha" minWidth="90" prefWidth="110"/>
                <TableColumn fx:id="colCliente" text="Cliente" minWidth="180" prefWidth="260"/>
                <TableColumn fx:id="colTotal" text="Total" minWidth="90" prefWidth="120"/>
                <TableColumn fx:id="colEstado" text="Estado" minWidth="90" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
