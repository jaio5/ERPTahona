<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://www2.agenciatributaria.gob.es/static_files/common/internet/dep/aplicaciones/es/aeat/tike/cont/ws/RegistroFacturaVerifactu.xsd"
           xmlns="https://www2.agenciatributaria.gob.es/static_files/common/internet/dep/aplicaciones/es/aeat/tike/cont/ws/RegistroFacturaVerifactu.xsd"
           elementFormDefault="qualified">

    <xs:element name="RegistroFacturaVerifactu">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Cabecera" type="CabeceraType"/>
                <xs:choice>
                    <xs:element name="RegistroAlta" type="RegistroAltaType"/>
                    <xs:element name="RegistroAnulacion" type="RegistroAnulacionType"/>
                </xs:choice>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="CabeceraType">
        <xs:sequence>
            <xs:element name="Emisor" type="EmisorType"/>
            <xs:element name="SistemaInformatico" type="SistemaInformaticoType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="EmisorType">
        <xs:sequence>
            <xs:element name="NIF" type="xs:string"/>
            <xs:element name="NombreRazonSocial" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SistemaInformaticoType">
        <xs:sequence>
            <xs:element name="NombreSistema" type="xs:string"/>
            <xs:element name="Version" type="xs:string"/>
            <xs:element name="IdDispositivo" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="RegistroAltaType">
        <xs:sequence>
            <xs:element name="NumFactura" type="xs:string"/>
            <xs:element name="SerieFactura" type="xs:string"/>
            <xs:element name="FechaExpedicion" type="xs:string"/>
            <xs:element name="FechaHoraGeneracion" type="xs:string"/>
            <xs:element name="TipoFactura" type="xs:string"/>
            <xs:element name="Destinatario" type="DestinatarioType" minOccurs="0"/>
            <xs:element name="Desglose" type="DesgloseType" minOccurs="0"/>
            <xs:element name="CuotaTotal" type="xs:decimal"/>
            <xs:element name="ImporteTotal" type="xs:decimal"/>
            <xs:element name="Hash" type="xs:string"/>
            <xs:element name="HashAnterior" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="RegistroAnulacionType">
        <xs:sequence>
            <xs:element name="NumFactura" type="xs:string"/>
            <xs:element name="SerieFactura" type="xs:string"/>
            <xs:element name="FechaExpedicion" type="xs:string"/>
            <xs:element name="FechaHoraGeneracion" type="xs:string"/>
            <xs:element name="MotivoAnulacion" type="xs:string" minOccurs="0"/>
            <xs:element name="Hash" type="xs:string"/>
            <xs:element name="HashAnterior" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="DestinatarioType">
        <xs:sequence>
            <xs:element name="NIF" type="xs:string" minOccurs="0"/>
            <xs:element name="NombreRazonSocial" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="DesgloseType">
        <xs:sequence>
            <xs:element name="BaseImponible" type="xs:decimal"/>
            <xs:element name="CuotaIVA" type="xs:decimal"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
