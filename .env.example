# Copia este fichero a .env y rellena los secretos antes de: docker compose up -d --build
# El fichero .env NO se commitea (está en .gitignore).

# ── Base de datos ──────────────────────────────────────────────────────────
# Contraseñas del MySQL del contenedor (cámbialas en el primer despliegue)
MYSQL_ROOT_PASSWORD=cambia-esta-root
MYSQL_PASSWORD=cambia-esta-app
# Puerto del host para acceder al MySQL del contenedor (3307 para no chocar con un MySQL local)
MYSQL_HOST_PORT=3307

# ── Aplicación ─────────────────────────────────────────────────────────────
# Puerto del host donde se sirve la aplicación (http://localhost:8080)
APP_PORT=8080

# Contraseña inicial del usuario admin (se exige cambiarla en el primer acceso)
ADMIN_DEFAULT_PASSWORD=CambiaEstaClave123

# Clave AES para el cifrado de datos sensibles. Generar con:  openssl rand -base64 32
# ⚠ No la cambies una vez haya datos cifrados: quedarían ilegibles.
CIFRADO_AES_KEY=

# Secreto del hash de contraseñas (PBKDF2). Generar con:  openssl rand -base64 32
# ⚠ No lo cambies una vez creados usuarios: sus contraseñas dejarían de validar.
SECURITY_PBKDF2_SECRET=

# ── Email (opcional): envío de facturas PDF a clientes ────────────────────
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=

# ── VeriFactu (opcional hasta tener el certificado real) ──────────────────
# Copia el certificado .p12 dentro de la carpeta certs/ del proyecto y apunta aquí:
#VERIFACTU_CERT_PATH=certs/mi_certificado.p12
#VERIFACTU_CERT_PASSWORD=
#VERIFACTU_KEY_ALIAS=mi_certificado
# Remisión real a AEAT: actívala SOLO tras validar contra el entorno de pruebas
#VERIFACTU_AEAT_ENABLED=false
#VERIFACTU_AEAT_ENDPOINT=https://prewww2.aeat.es/wlpl/AVAC-FACT/ws/fe/SiiVerifactu
