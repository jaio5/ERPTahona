# Copia este fichero a .env y rellena los secretos antes de: docker compose up -d --build
# El fichero .env NO se commitea (está en .gitignore).

# ── Base de datos ──────────────────────────────────────────────────────────
# Contraseñas del MySQL del contenedor (cámbialas en el primer despliegue)
MYSQL_ROOT_PASSWORD=cambia-esta-root
MYSQL_PASSWORD=cambia-esta-app
# Puerto del host para acceder al MySQL del contenedor (3307 para no chocar con un MySQL local)
MYSQL_HOST_PORT=3307

# ── TLS / HTTPS (proxy Caddy, ver deploy/Caddyfile) ────────────────────────
# La app ya no publica el puerto 8080: todo el tráfico entra por Caddy en
# HTTPS. Puertos del host que publica el proxy:
#HTTP_PORT=80
#HTTPS_PORT=443

# Dominio del sitio. En LAN sin dominio público, deja localhost o pon el
# nombre/IP con el que accederán los equipos (p.ej. erp.local o 192.168.1.50).
#ERP_DOMAIN=localhost

# Modo TLS de Caddy:
#  - internal (por defecto): certificado de la CA interna de Caddy, para LAN
#    sin dominio público. Instala la CA raíz de Caddy en los equipos cliente
#    para evitar avisos del navegador (ver docs/RUNBOOK.md).
#  - tu-email@dominio.com: activa Let's Encrypt para ERP_DOMAIN (requiere
#    dominio público apuntando a este host y puertos 80/443 abiertos).
#ERP_TLS_MODE=internal

# La cookie de sesión segura va activa por defecto (acceso siempre por HTTPS).
# Solo ponla a false si eliminas el proxy TLS (no recomendado).
#SESSION_COOKIE_SECURE=true

# Contraseña inicial del usuario admin (se exige cambiarla en el primer acceso).
# OJO: solo vale para el primer login; después la contraseña real es la elegida
# en ese cambio obligatorio, no la de este fichero. 5 intentos fallidos bloquean
# la cuenta temporalmente.
ADMIN_DEFAULT_PASSWORD=CambiaEstaClave123

# Clave AES para el cifrado de datos sensibles. Generar con:  openssl rand -base64 32
# ⚠ No la cambies una vez haya datos cifrados: quedarían ilegibles.
CIFRADO_AES_KEY=

# Secreto del hash de contraseñas (PBKDF2). Generar con:  openssl rand -base64 32
# ⚠ No lo cambies una vez creados usuarios: sus contraseñas dejarían de validar.
SECURITY_PBKDF2_SECRET=

# ── Email (opcional): envío de facturas PDF a clientes ────────────────────
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=

# ── VeriFactu (opcional hasta tener el certificado real) ──────────────────
# Copia el certificado .p12 dentro de la carpeta certs/ del proyecto y apunta aquí:
#VERIFACTU_CERT_PATH=certs/mi_certificado.p12
#VERIFACTU_CERT_PASSWORD=
#VERIFACTU_KEY_ALIAS=mi_certificado
# Remisión real a AEAT: actívala SOLO tras validar contra el entorno de pruebas.
# Endpoint oficial de pruebas (homologación); en producción usa la URL de www1.
#VERIFACTU_AEAT_ENABLED=false
#VERIFACTU_AEAT_ENDPOINT=https://prewww1.aeat.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/VerifactuSOAP
# Para un despliegue con remisión real, parte de .env.prod.example (VeriFactu completo).
