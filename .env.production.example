SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-host:3306/tahona?useSSL=true&requireSSL=true&serverTimezone=Europe/Madrid&characterEncoding=UTF-8&useUnicode=true
SPRING_DATASOURCE_USERNAME=erp_app
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
ERP_LOG_FILE=logs/erp-tahona.log
ERP_BACKUP_DIRECTORY=backups
ERP_BACKUP_RETENTION_DAYS=30

CIFRADO_AES_KEY=base64-32-byte-key
CIFRADO_AES_USE_PBKDF2=false
CIFRADO_AES_PBKDF2_SALT=
CIFRADO_AES_PBKDF2_ITERATIONS=185000

SECURITY_PBKDF2_SECRET=change-me
SECURITY_PBKDF2_ITERATIONS=185000
SECURITY_PBKDF2_HASH_WIDTH=256

VERIFACTU_CERT_PATH=/secure/certs/verifactu.p12
VERIFACTU_CERT_PASSWORD=change-me
VERIFACTU_KEY_ALIAS=change-me
VERIFACTU_KEY_PASSWORD=change-me
VERIFACTU_AEAT_ENABLED=false
# Para produccion real con remision AEAT, habilita VERIFACTU_AEAT_ENABLED=true
# y usa el endpoint oficial que corresponda al entorno validado por AEAT.
VERIFACTU_AEAT_ENDPOINT=https://prewww2.aeat.es/wlpl/AVAC-FACT/ws/fe/SiiVerifactu

ADMIN_DEFAULT_PASSWORD=change-me-before-first-run

CLIENTES_AUTOCOMPLETAR_ENABLED=true
CLIENTES_AUTOCOMPLETAR_ENDPOINT=https://apiempresas.es/api/v1/companies
CLIENTES_AUTOCOMPLETAR_API_KEY=change-me
CLIENTES_AUTOCOMPLETAR_TIMEOUT_SECONDS=8
CLIENTES_AUTOCOMPLETAR_CIF_PARAM=cif
CLIENTES_AUTOCOMPLETAR_NOMBRE_PARAM=q

APP_UPDATE_ENABLED=true
APP_UPDATE_REMOTE=origin
APP_UPDATE_BRANCH=produccion
APP_UPDATE_TIMEOUT_SECONDS=60
APP_UPDATE_WORKDIR=
