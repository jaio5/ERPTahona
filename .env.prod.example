# =============================================================================
#  Plantilla de configuración para PRODUCCIÓN con remisión real a la AEAT.
#  Copia este fichero a .env y rellénalo:   cp .env.prod.example .env
#  El .env NO se commitea (está en .gitignore). Guárdalo con cuidado: contiene
#  secretos que, si cambian con datos ya cifrados, los dejan ilegibles.
#
#  Antes de activar la remisión real a la AEAT (VERIFACTU_AEAT_ENABLED=true)
#  DEBES haber homologado con tu certificado real contra el entorno de pruebas
#  (prewww) de la AEAT. El guard de arranque en perfil prod aborta si se activa
#  la remisión apuntando a un endpoint de pruebas.
# =============================================================================

# ── Base de datos ──────────────────────────────────────────────────────────
# Contraseñas del MySQL del contenedor. Usa cadenas largas y aleatorias.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Puerto del host para el MySQL del contenedor (solo si necesitas acceso directo)
MYSQL_HOST_PORT=3307

# ── TLS / HTTPS (proxy Caddy) ──────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
# Dominio público real que apunta a este host (registro A/AAAA).
ERP_DOMAIN=erp.tuempresa.es
# Let's Encrypt: pon tu email de administrador (requiere dominio público y
# puertos 80/443 abiertos). Para LAN sin dominio, usa "internal".
ERP_TLS_MODE=admin@tuempresa.es
# Cookie de sesión segura (acceso siempre por HTTPS): déjala activa.
SESSION_COOKIE_SECURE=true

# ── Secretos de la aplicación ──────────────────────────────────────────────
# Contraseña inicial de admin (se exige cambiarla en el primer acceso).
ADMIN_DEFAULT_PASSWORD=
# Clave AES para cifrado de datos sensibles.   openssl rand -base64 32
# ⚠ No la cambies una vez haya datos cifrados.
CIFRADO_AES_KEY=
# Secreto del hash de contraseñas (PBKDF2).     openssl rand -base64 32
# ⚠ No lo cambies una vez creados usuarios.
SECURITY_PBKDF2_SECRET=

# ── Email (opcional): envío de facturas PDF a clientes ─────────────────────
#MAIL_HOST=smtp.tuempresa.es
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=

# ── VeriFactu — CERTIFICADO Y FIRMA ────────────────────────────────────────
# Copia el certificado real .p12 (representante o sello de la empresa) dentro
# de la carpeta certs/ del proyecto y apunta aquí (ruta relativa a /app).
VERIFACTU_CERT_PATH=certs/certificado-empresa.p12
VERIFACTU_CERT_PASSWORD=
# Alias de la clave dentro del .p12 (list -keystore para verlo). Por defecto:
VERIFACTU_KEY_ALIAS=mi_certificado
# Contraseña de la clave si difiere de la del almacén (si no, déjala vacía).
#VERIFACTU_KEY_PASSWORD=

# ── VeriFactu — REMISIÓN A LA AEAT ─────────────────────────────────────────
# Actívala SOLO tras homologar con este certificado contra el entorno de pruebas.
VERIFACTU_AEAT_ENABLED=true
# Endpoint de PRODUCCIÓN (certificado de persona/representante):
VERIFACTU_AEAT_ENDPOINT=https://www1.agenciatributaria.gob.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/VerifactuSOAP
#   Con certificado de SELLO usa www10 en vez de www1.
#   Para HOMOLOGAR primero, usa el de pruebas:
#   https://prewww1.aeat.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/VerifactuSOAP
# URL base del QR de verificación (producción):
VERIFACTU_QR_BASE_URL=https://www2.agenciatributaria.gob.es/wlpl/TIKE-CONT/ValidarQR

# ── VeriFactu — IDENTIDAD DEL PRODUCTOR DEL SOFTWARE ───────────────────────
# Bloque "SistemaInformatico" del XML: identifica a quien desarrolla el SIF.
VERIFACTU_SISTEMA_NOMBRE_PRODUCTOR=
VERIFACTU_SISTEMA_NIF_PRODUCTOR=
VERIFACTU_SISTEMA_ID=01
VERIFACTU_SISTEMA_NUMERO_INSTALACION=1

# =============================================================================
#  Además del .env, completa DENTRO de la app (no son variables de entorno):
#   1. Pantalla «Empresa»: NIF/CIF y razón social del emisor.
#   2. «Cumplimiento fiscal → Datos del SIF»: nombre del sistema, versión,
#      id de dispositivo/instalación, NIF emisor y modalidad = VERIFACTU.
#   3. Pulsa «Emitir declaración responsable» (registra versión y huella SHA-256).
#   4. Pulsa «Iniciar funcionamiento VERI*FACTU».
#  La pantalla de Cumplimiento fiscal muestra el checklist; cuando todo esté en
#  verde, la app permitirá emitir facturas con remisión a la AEAT.
# =============================================================================
