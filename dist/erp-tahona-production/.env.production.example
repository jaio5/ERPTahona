VERIFACTU_KEY_ALIAS=change-me
VERIFACTU_KEY_PASSWORD=change-me
VERIFACTU_AEAT_ENABLED=false
VERIFACTU_AEAT_ENDPOINT=https://prewww2.aeat.es/wlpl/AVAC-FACT/ws/fe/SiiVerifactu

ADMIN_DEFAULT_PASSWORD=change-me-before-first-run
