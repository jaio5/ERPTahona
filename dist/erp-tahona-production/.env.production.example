SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-host:3306/tahona?useSSL=true&requireSSL=true&serverTimezone=Europe/Madrid&characterEncoding=UTF-8&useUnicode=true
SPRING_DATASOURCE_USERNAME=erp_app
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20

CIFRADO_AES_KEY=base64-32-byte-key
CIFRADO_AES_USE_PBKDF2=false
CIFRADO_AES_PBKDF2_SALT=
